# ---------------------------------------------------------------------------
# Shekhawati Impex ERP - server environment
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/shekhawati_erp?schema=public"

# Server (used from Phase 1 onwards - no API is exposed in Phase 0)
PORT=4000
NODE_ENV=development

# Auth (used from Phase 1 onwards)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_DAYS=7
BCRYPT_SALT_ROUNDS=10

# CORS origin for the Vite client (Phase 1 onwards)
CLIENT_ORIGIN="http://localhost:5175"

# Seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMeAdmin1"
SEED_DEFAULT_USER_PASSWORD="ChangeMeUser1"

# --- The company, as it appears on a printed document -----------------------
#
# COMPANY_STATE_CODE is the first two digits of your own GSTIN. It decides
# whether a purchase is taxed CGST+SGST (same state as the vendor) or IGST
# (different state), so getting it wrong mis-taxes every purchase invoice.
# 08 is Rajasthan.
COMPANY_NAME=Sekawati Impex
COMPANY_ADDRESS=G-90, Garment Zone, Sitapura Industrial Area, Jaipur - 302022
COMPANY_GSTIN=
COMPANY_STATE_CODE=08
COMPANY_STATE_NAME=Rajasthan

# ---------------------------------------------------------------------------
#  Notifications - all optional. In-app notifications need none of these.
#  Email also needs:  npm install nodemailer   (in /server)
# ---------------------------------------------------------------------------
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# WhatsApp Business Cloud API (Meta). Business-initiated messages need an
# approved template taking two body parameters: {{1}} title, {{2}} detail.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
NOTIFY_DISPATCH_SECONDS=30

# The evening summary of the day's work, India time (HH:MM, 24-hour), sent to
# holders of REPORT.SUMMARY. In-app always; email / WhatsApp per their settings.
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME=20:00
# Optional. With a key, Claude writes up to five "Needs attention" lines on top
# of the daily summary from the day's figures and the week before. Only piece
# counts, unit names, style and document numbers are sent. Empty = off.
ANTHROPIC_API_KEY=
DAILY_SUMMARY_AI=true

# The assistant (Dashboard > Ask). Uses the same ANTHROPIC_API_KEY; off without
# it. Report rows and document chunks the asking user may see on screen are
# sent to Claude, and nothing else. See docs/AI-ASSISTANT.md.
ASSISTANT_MODEL=claude-sonnet-5-5
# Where the embedding model is downloaded on first use (about 90 MB). Empty =
# the system temp folder. On Azure App Service set /home/assistant-model.
ASSISTANT_MODEL_CACHE=
