/// EXCEL SHEET: "Style Master (BOM)"   (Role Acess - Head Office / Admin)
model Style {
  id String @id @default(uuid()) @db.Uuid

  /// Excel: "Style No" - e.g. TR-0751-008
  styleNo                   String       @unique @map("style_no") @db.VarChar(40)
  /// Excel: "Style Description" (Manual)
  styleDescription          String       @map("style_description") @db.VarChar(200)
  /// Excel: "Buyer" (Dropdown -> Buyer Master)
  buyerId                   String       @map("buyer_id") @db.Uuid
  buyer                     Buyer        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  /// Excel: "Category" (Dropdown -> L_StyleCategory)
  category                  String       @db.VarChar(60)
  /// Excel: "Fabric Content" (Dropdown -> L_FabricContent)
  fabricContent             String?      @map("fabric_content") @db.VarChar(80)
  /// L_ColorCode - the colourway this style number IS.
  ///
  /// A colour already exists on the BOM line and on the order line, and this
  /// is neither of those. The buyer numbers a colourway as its own style -
  /// TP-0007-008 is the Natural pouch, TP-0007-009 the Black one - so the
  /// colour is part of what the style number identifies, not a choice made
  /// later when the material or the order is written. It arrived in the
  /// requirement sheets as "Color: Natural" inside the free-text remark,
  /// where nothing could filter or group by it.
  colorCode                 String?      @map("color_code") @db.VarChar(60)
  /// Excel: "Avg Fabric Utilization / Pc" (Manual) - drives the
  /// "Order as per Style" requirement calculation (Process Doc s.5).
  avgFabricUtilizationPerPc Decimal      @map("avg_fabric_utilization_per_pc") @db.Decimal(12, 4)
  /// Unit that avgFabricUtilizationPerPc is expressed in. The workbook works
  /// in Mtrs throughout; made explicit so Kg-based styles remain possible.
  avgUtilizationUom         String       @default("Mtrs") @map("avg_utilization_uom") @db.VarChar(20)
  /// Excel: "Size Group" (Manual -> L_SizeGroup)
  sizeGroup                 String?      @map("size_group") @db.VarChar(40)
  /// "Qty/ctn" from the buyer's requirement sheet - how many finished pieces
  /// of this style go in one export carton.
  ///
  /// THIS IS A SPECIFICATION, NOT A PACKING RECORD. There is still no packing
  /// execution in this system - no packing list, no carton row, no packed
  /// quantity (see the PlanDept comment above) - and this column does not
  /// start one. It is a number the buyer states per style, the way the
  /// utilisation per piece is, and it is held here so that whoever does build
  /// packing reads it from the style rather than from a sentence in Remarks.
  ///
  /// Nullable: most styles arrive without it, and 0 cartons of a bag is not a
  /// specification anybody means, so the column is > 0 or absent.
  qtyPerCarton              Int?         @map("qty_per_carton")
  /// Excel: "Image Ref" (Manual) - e.g. IMG/TR0751008.jpg
  imageRef                  String?      @map("image_ref") @db.VarChar(200)
  /// Excel: "Status" (Dropdown -> Active/Inactive)
  status                    StatusActive @default(ACTIVE)
  /// Excel: "Remarks" (Text)
  remarks                   String?      @db.Text

  // --- THE SPEC SHEET --------------------------------------------------------
  //
  //  What the buyer's tech pack says the finished bag IS. Until now these lived
  //  in Remarks ("40x38x10 cm, 60 cm handle drop, zip closure"), where nothing
  //  could print them on a cutting challan or check them against a sample.
  //
  //  All optional: a style is registered before the tech pack is final, and a
  //  blank is honest where an invented number is not. Every measurement is in
  //  `dimensionUom`, stated once, so a style measured in inches is not silently
  //  read as centimetres.

  /// L x W x H of the finished bag, and the gusset (the side panel's width).
  bagLength      Decimal? @map("bag_length") @db.Decimal(10, 2)
  bagWidth       Decimal? @map("bag_width") @db.Decimal(10, 2)
  bagHeight      Decimal? @map("bag_height") @db.Decimal(10, 2)
  gussetWidth    Decimal? @map("gusset_width") @db.Decimal(10, 2)
  /// Top of the bag to the top of the handle, when the handle is held up.
  handleDrop     Decimal? @map("handle_drop") @db.Decimal(10, 2)
  /// Full length of a shoulder / cross-body strap, where the style has one.
  strapLength    Decimal? @map("strap_length") @db.Decimal(10, 2)
  /// The unit every measurement above is in: "cm" or "inch".
  dimensionUom   String   @default("cm") @map("dimension_uom") @db.VarChar(10)
  /// L_Closure - Zip, Magnetic Snap, Drawstring, Open Top ...
  closure        String?  @db.VarChar(60)
  /// L_Lining - Unlined, Cotton, Polyester, PU Coated ...
  lining         String?  @db.VarChar(60)
  /// Where the print goes, in the tech pack's words - "Front centre, 25 cm
  /// below top edge, 20x20 cm".
  printPlacement String?  @map("print_placement") @db.Text
  /// The artwork revision this style is currently made to - "v3", "AW-0415 R2".
  /// Printed on the cutting challan so a unit never prints last month's file.
  artworkVersion String?  @map("artwork_version") @db.VarChar(40)

  /// The panels one finished bag is cut into. See StyleComponent.
  components StyleComponent[]

  bomLines        StyleBomLine[]
  /// FOB cost sheets, one per version. See model StyleCostSheet.
  costSheets      StyleCostSheet[]
  orders          BuyerOrder[]
  fabricIssues    FabricIssue[]
  printings       Printing[]
  scrutinies      FabricScrutiny[]
  cuttingIssues   CuttingIssue[]
  purchaseOrders  PurchaseOrder[]
  /// C5 - cutting requirements raised for this style.
  cuttingChallans CuttingChallan[]
  /// C7 - plan approval versions raised style-number-wise.
  planApprovals   PlanApproval[]
  /// C12 - raw material plans priced off this style's BOM.
  materialPlans   MaterialPlan[]
  /// C13 - the order lines that buy this style.
  orderLines      BuyerOrderLine[]
  plannings       Planning[]

  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?            @map("created_by_id") @db.Uuid
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById       String?            @map("updated_by_id") @db.Uuid
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  deletedById       String?            @map("deleted_by_id") @db.Uuid
  dyeIssues         DyeIssue[]
  cutPiecesReceipts CutPiecesReceipt[]

  @@index([buyerId])
  @@index([category])
  @@index([colorCode])
  @@index([status])
  @@index([deletedAt])
  @@map("styles")
}

/// Style BOM line. The workbook sheet is titled "Style Master (BOM)" but only
/// carries the fabric average per piece; the required material breakdown
/// (fabric + handle + zipper + label ...) is what Procurement needs in order to
/// raise a PO "as per Style". One line per material required per finished piece.
model StyleBomLine {
  id      String @id @default(uuid()) @db.Uuid
  styleId String @map("style_id") @db.Uuid
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// L_ItemCategory: Fabric / Accessories / Handle / Zipper / Label / Thread /
  /// Button / Packaging Material
  itemCategory    String  @map("item_category") @db.VarChar(60)
  /// L_FabricSubCat when itemCategory = Fabric ("10 oz", "Canvas 12x12")
  subCategory     String? @map("sub_category") @db.VarChar(60)
  /// L_AccessoriesItem when itemCategory = Accessories ("Cotton Handle")
  accessoriesItem String? @map("accessories_item") @db.VarChar(80)
  /// L_AccessoryVariety, only when accessoriesItem is set: WHICH button or
  /// zipper. Carried to the material plan, and from the quotation to the PO,
  /// the GRN and the stock item, so the variety is chosen, never retyped.
  accessoryType   String? @map("accessory_type") @db.VarChar(120)
  /// Free description as it should print on the PO
  description     String? @db.VarChar(200)
  /// L_ColorCode
  colorCode       String? @map("color_code") @db.VarChar(60)
  /// L_FabricContent
  content         String? @db.VarChar(80)
  /// L_GSM
  gsm             String? @db.VarChar(20)
  /// L_Count
  count           String? @db.VarChar(20)
  /// L_Construction
  construction    String? @db.VarChar(20)

  /// The size or specification that tells two otherwise identical materials
  /// apart.
  ///
  /// The columns above identify CLOTH - sub-category, GSM, count, construction.
  /// Most of a bag's bill of materials is not cloth, and what separates one
  /// line from the next is a measurement those columns have no room for: a
  /// 25 mm puller from a 20 mm one, 1.25" webbing from 1.5", thread on a
  /// 5/1000 mtr cone from thread on a 2000 yard one.
  ///
  /// Free text on purpose. These arrive in the buyer's own notation, and a
  /// dropdown per material family would have to be invented and then re-typed
  /// into from every sheet.
  variant String? @db.VarChar(60)

  /// L_UOM. C9's "unit of measure" for the utilisation below - the same
  /// column, because a BOM line's material and its utilisation are measured
  /// in one unit by construction and two columns could disagree.
  uom String @db.VarChar(20)

  /// C9 - AVERAGE RAW-MATERIAL UTILISATION PER PIECE, as given by the buyer.
  ///
  /// THIS IS A RENAME of `qty_per_pc`, not a new column. That column already
  /// held exactly this number ("quantity of this material consumed by one
  /// finished piece") and is what every requirement calculation already read;
  /// adding a second column beside it would have left two fields meaning one
  /// thing and invited them to drift. The API still accepts `qtyPerPc` as a
  /// deprecated alias so nothing outside this repository breaks.
  ///
  /// NOT NULL, and > 0 at the database level: a style with no utilisation
  /// cannot have its requirement computed, and C9 requires that to be a loud
  /// validation error rather than a silent requirement of zero.
  avgUtilisationPerPiece Decimal @map("avg_utilisation_per_piece") @db.Decimal(12, 4)

  /// C9 - the day this utilisation starts applying.
  ///
  /// A buyer revises a measurement sheet mid-season. Without a date the
  /// revision would retrospectively re-price plans and purchase orders that
  /// were computed under the old figure; with one, a document resolves the
  /// line that was effective on its own date.
  effectiveFrom DateTime @map("effective_from") @db.Date

  /// Process wastage allowance on top of the utilisation, as a fraction
  /// (0.02 = 2%).
  wastagePct Decimal @default(0) @map("wastage_pct") @db.Decimal(9, 6)
  /// HSN as used on the PO / GRN for this material.
  hsnCode    String? @map("hsn_code") @db.VarChar(20)
  isActive   Boolean @default(true) @map("is_active")
  remarks    String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([styleId, lineNo])
  @@index([styleId])
  @@index([itemCategory])
  @@index([effectiveFrom])
  @@index([deletedAt])
  @@map("style_bom_lines")
}

/// What kind of panel a style component is. Closed, because two rules read it:
/// handles are counted separately on the cut-pieces receipt and the cutting
/// issue, and everything else is a panel. The component's own wording lives in
/// `name` beside it.
enum StyleComponentType {
  FRONT_PANEL
  BACK_PANEL
  GUSSET
  BASE
  HANDLE
  STRAP
  POCKET
  FLAP
  LINING
  OTHER
}

/// ONE PANEL OF THE BAG, AND HOW MANY OF IT ONE BAG NEEDS.
///
/// ---------------------------------------------------------------------------
///  WHY THIS TABLE EXISTS
///
///  The cutting floor does not cut "bags", it cuts panels: a tote is a front,
///  a back, a gusset and two handles - five pieces of cloth for one bag. The
///  count of those pieces was TYPED on every cut-pieces receipt and cutting
///  issue ("handles received: 2,000"), which is the product of two numbers the
///  office already knows - bags cut, and handles per bag - worked out in
///  somebody's head each time.
///
///  This is the second of those numbers, held once on the style. The receipt
///  and the cutting issue multiply by it, and freeze what they multiplied by,
///  so a style whose panel list is corrected next month does not change what an
///  old receipt says was counted.
///
///  NOT THE BOM. The BOM says what MATERIAL one bag consumes; this says what
///  SHAPES are cut from it. `bomLineNo` links a panel to the material it is cut
///  from where that is worth saying (a lining panel from the lining cloth), and
///  is optional because on most totes every panel is the shell fabric.
/// ---------------------------------------------------------------------------
model StyleComponent {
  id      String @id @default(uuid()) @db.Uuid
  styleId String @map("style_id") @db.Uuid
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  componentType StyleComponentType @map("component_type")
  /// L_StyleComponent, or the tech pack's own name - "Front panel", "Inner
  /// zip pocket".
  name          String             @db.VarChar(80)
  /// How many of this panel one finished bag needs. Two handles, one front.
  piecesPerBag  Int                @map("pieces_per_bag")

  /// The panel's cut size, in the style's `dimensionUom`. Optional - the
  /// marker is often made before anybody writes these down.
  cutLength Decimal? @map("cut_length") @db.Decimal(10, 2)
  cutWidth  Decimal? @map("cut_width") @db.Decimal(10, 2)

  /// The Style BOM line (by line number) this panel is cut from, where it is
  /// not simply the shell fabric.
  bomLineNo Int?    @map("bom_line_no")
  remarks   String? @db.Text

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([styleId, lineNo])
  @@index([styleId])
  @@map("style_components")
}

// ===========================================================================
//  4. BUYER ORDER
// ===========================================================================

/// EXCEL SHEET: "Order" - Order Format   (Role Acess - Merchandising Team)
/// Note on the original sheet: "Buyer PO num is their order no", so orderNo is
/// entered manually and is the buyer's own PO number (e.g. B9641IS).
model BuyerOrder {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `excessApprovalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Excel: "Order No" (Manual) - the buyer PO number
  orderNo           String        @unique @map("order_no") @db.VarChar(40)
  /// Excel: "Order Date" (Auto)
  orderDate         DateTime      @map("order_date") @db.Date
  /// Excel: "Item Description" (Text)
  itemDescription   String?       @map("item_description") @db.VarChar(200)
  /// Excel: "Buyer" (Dropdown -> Buyer Master)
  buyerId           String        @map("buyer_id") @db.Uuid
  buyer             Buyer         @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  /// Excel: "Bill To" (Auto - defaults from Buyer Master)
  billTo            String?       @map("bill_to") @db.Text
  /// Excel: "Ship to" (Dropdown / Manual)
  shipTo            String?       @map("ship_to") @db.Text
  /// Excel: "Buyer Delivery Date" (Manual)
  buyerDeliveryDate DateTime?     @map("buyer_delivery_date") @db.Date
  /// Excel: "Order Qty" (Manual) - finished pieces.
  ///
  /// C13: SERVER-CALCULATED. The sum of `orderQty` across the order's lines,
  /// recomputed on every write and never accepted from a client. It was a
  /// typed figure while an order could only hold one style; now that an order
  /// holds several, a header quantity somebody could type independently of the
  /// lines would be a second answer to "how many pieces is this order".
  orderQty          Decimal       @map("order_qty") @db.Decimal(18, 4)
  /// Excel: "Style No" (Dropdown -> Style Master).
  ///
  /// C13: THE LEAD STYLE - line 1's style, kept in step by the service.
  ///
  /// It is NOT the authority on what the order contains; `lines` is. This
  /// column stays because the workbook prints one style per order row, because
  /// every list screen and report reads it, and because on a single-style order
  /// - which is every order that existed before C13 - it is exactly right.
  ///
  /// ANYTHING COMPUTING A REQUIREMENT MUST USE THE LINE, NOT THIS. A style's
  /// consumption has to be multiplied by the pieces of THAT style, and only
  /// BuyerOrderLine knows that number. Reading this column together with the
  /// header quantity is what produced the wrong figure C13 exists to fix.
  styleId           String        @map("style_id") @db.Uuid
  style             Style         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  /// Excel: "Color Code" (Dropdown -> L_ColorCode). C13: the lead line's colour.
  /// Per-line colour lives on BuyerOrderLine.
  colorCode         String?       @map("color_code") @db.VarChar(60)
  /// Excel: "Currency" (Dropdown -> L_Currency)
  currency          String?       @db.VarChar(10)
  /// Excel: "Ship Mode" (Dropdown -> L_ShipMode)
  shipMode          String?       @map("ship_mode") @db.VarChar(40)
  /// Excel: "Size Group" (Manual -> L_SizeGroup)
  sizeGroup         String?       @map("size_group") @db.VarChar(40)
  /// Excel: "Status" (Auto -> L_StatusGeneral)
  status            StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Manual)
  remarks           String?       @db.Text

  // --- COMMERCIAL TERMS ------------------------------------------------------
  //
  //  What the buyer is paying, and against which of THEIR documents. None of
  //  these is structural: a price agreed late or corrected after a revised PO
  //  does not change what gets cut or bought, so these stay editable while
  //  the order is alive (see buyerOrder.service.js setPricing()).

  /// The buyer's own purchase order number and date - what their invoice
  /// matching and every shipping document quotes back. `orderNo` is OURS.
  buyerPoNo     String?   @map("buyer_po_no") @db.VarChar(60)
  buyerPoDate   DateTime? @map("buyer_po_date") @db.Date
  /// The date the goods must leave the factory. Earlier than the buyer's
  /// delivery date by the transit time; the one the floor is planned to.
  exFactoryDate DateTime? @map("ex_factory_date") @db.Date
  /// Incoterm the price is quoted on - FOB, CIF, EXW. Defaults from the buyer.
  priceTerms    String?   @map("price_terms") @db.VarChar(150)
  /// Defaults from the buyer - "30 days from B/L", "LC at sight".
  paymentTerms  String?   @map("payment_terms") @db.VarChar(150)
  /// Rupees per one unit of `currency`, as booked for this order. Null for an
  /// INR order or one whose rate is not fixed yet; nothing guesses it.
  exchangeRate  Decimal?  @map("exchange_rate") @db.Decimal(18, 6)
  /// SERVER-CALCULATED. Sum of the lines' `lineValue`, in the order currency.
  /// Null while any line is still unpriced - a partial total would read as
  /// the order's value and be wrong.
  orderValue    Decimal?  @map("order_value") @db.Decimal(18, 2)
  /// SERVER-CALCULATED. orderValue x exchangeRate. Null unless both exist.
  orderValueInr Decimal?  @map("order_value_inr") @db.Decimal(18, 2)

  /// C5 - cutting requirements raised against this order.
  cuttingChallans CuttingChallan[]

  /// C9 - the buyer's measurement sheet this order's utilisation figures came
  /// from. OPTIONAL, and a reference rather than a blob: this system has no
  /// file store, and `Style.imageRef` set the convention of naming the
  /// document rather than holding it. Recorded so an order can be traced back
  /// to the sheet that justified its per-piece figures.
  measurementSheetRef  String? @map("measurement_sheet_ref") @db.VarChar(200)
  measurementSheetNote String? @map("measurement_sheet_note") @db.Text
  /// Excel: "Excess" - note on the sheet: "Approval from dinesh sir".
  /// Stored as a fraction (0.02 = 2%) exactly as the workbook holds it.
  /// This is the excess REQUESTED. What may actually be produced or procured is
  /// excessApprovedPct, which is zero until the Director approves.
  excessPct            Decimal @default(0) @map("excess_pct") @db.Decimal(9, 6)

  // --- Excess approval workflow ("Approval from dinesh sir") ---------------

  /// NOT_REQUIRED when excessPct is zero; otherwise PENDING until decided.
  excessApprovalStatus  ExcessApprovalStatus @default(NOT_REQUIRED) @map("excess_approval_status")
  /// The excess the Director actually granted. May be less than requested.
  /// Zero unless excessApprovalStatus is APPROVED.
  excessApprovedPct     Decimal              @default(0) @map("excess_approved_pct") @db.Decimal(9, 6)
  /// Why the excess is being asked for - required when excessPct > 0.
  excessJustification   String?              @map("excess_justification") @db.Text
  /// Name as printed in the workbook ("Dinesh Sir").
  excessApprovedByName  String?              @map("excess_approved_by_name") @db.VarChar(120)
  excessApprovedById    String?              @map("excess_approved_by_id") @db.Uuid
  excessApprovedAt      DateTime?            @map("excess_approved_at") @db.Timestamptz(3)
  excessRejectionReason String?              @map("excess_rejection_reason") @db.Text

  /// SERVER-CALCULATED. orderQty x (1 + excessApprovedPct) - the ceiling on
  /// what may be cut, procured and shipped against this order. Recomputed on
  /// every write and on every approval decision; never accepted from a client.
  ///
  /// C13: this is the ORDER-WIDE total - the sum of the lines' own
  /// `effectiveQty`. The per-style ceiling is on the line.
  effectiveQty Decimal @map("effective_qty") @db.Decimal(18, 4)

  /// Number of amendments made after the excess was approved. Each one is
  /// recorded in document_amendments and returns the excess to PENDING.
  amendmentCount Int @default(0) @map("amendment_count")

  /// C13 - the styles this order is for, and how many pieces of each.
  /// THE AUTHORITY on what the order contains.
  lines           BuyerOrderLine[]
  plannings       Planning[]
  quotations      VendorQuotation[]
  purchaseOrders  PurchaseOrder[]
  stockLedger     StockLedger[]
  excessApprovals ExcessApproval[]
  fabricIssues    FabricIssue[]
  dyeIssues       DyeIssue[]
  printings       Printing[]
  scrutinies      FabricScrutiny[]
  planApprovals   PlanApproval[]
  cuttingIssues   CuttingIssue[]
  /// C12 - the raw material plans raised against this order.
  materialPlans   MaterialPlan[]
  /// C9 - the buyer's measurement sheets, held rather than referred to.
  attachments     BuyerOrderAttachment[]
  /// Cost sheets priced for this particular order, if any.
  costSheets      StyleCostSheet[]

  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?            @map("created_by_id") @db.Uuid
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById       String?            @map("updated_by_id") @db.Uuid
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  deletedById       String?            @map("deleted_by_id") @db.Uuid
  cutPiecesReceipts CutPiecesReceipt[]

  @@index([buyerId])
  @@index([styleId])
  @@index([status])
  @@index([excessApprovalStatus])
  @@index([orderDate])
  @@index([buyerDeliveryDate])
  @@index([exFactoryDate])
  @@index([buyerPoNo])
  @@index([deletedAt])
  @@map("buyer_orders")
}

// ===========================================================================
//  5. PLANNING
// ===========================================================================

/// EXCEL SHEETS: "Planning_" (header block) + "Planning" (allotment rows)
/// (Role Acess - Planning Dept (Operator/GM))
///
/// "Planning_" holds the form header: Planning Department, Container No,
/// Order No, Style No, Order Qty; the grid underneath is Date / Deliverable
/// Size / Status / Remark. The flat "Planning" sheet is the same data listed
/// one allotment row per line. Modelled as header + lines.
/// A document attached to a buyer order - in practice the buyer's measurement
/// sheet, which is what the order's per-piece figures were derived from.
///
/// ===========================================================================
///  WHY THE BYTES ARE IN THE DATABASE
/// ===========================================================================
///
///  `BuyerOrder.measurementSheetRef` already existed and held a FILENAME, on
///  the reasoning that "this system has no file store". It was never wired to
///  a screen, and a reference is only worth what the shared folder behind it
///  is worth: the row survives, the file gets moved, and the order can no
///  longer be traced back to the sheet that justified its figures. That is
///  precisely the failure the column existed to prevent.
///
///  So the bytes live here. The alternative - a folder on the machine - makes
///  the backup two things instead of one, and the day only one of them is
///  restored the database is full of rows pointing at files that are gone.
///
///  The size cap and the accepted types are enforced in the service, not here:
///  a CHECK on a bytea length would refuse the row only after the upload had
///  already crossed the wire.
model BuyerOrderAttachment {
  id           String     @id @default(uuid()) @db.Uuid
  buyerOrderId String     @map("buyer_order_id") @db.Uuid
  buyerOrder   BuyerOrder @relation(fields: [buyerOrderId], references: [id], onDelete: Cascade)

  /// The name the file had on the uploader's machine, shown and used for the
  /// download. Not unique: two orders may both carry "measurements.pdf".
  fileName  String  @map("file_name") @db.VarChar(255)
  /// Checked against an allowlist on upload, and sent back as the Content-Type
  /// so a PDF opens as a PDF instead of being offered as an unknown download.
  mimeType  String  @map("mime_type") @db.VarChar(120)
  /// Stored so a listing can show the size without reading the bytes.
  sizeBytes Int     @map("size_bytes")
  /// Which revision of the sheet this is, in the office's own words.
  note      String? @db.Text

  /// The file itself. Never selected by the listing - see attachment.service.js.
  data Bytes

  /// Who put it there. Named as well as linked, because the whole point of an
  /// attachment is provenance and a deleted user must not erase it.
  uploadedById   String? @map("uploaded_by_id") @db.Uuid
  uploadedByName String? @map("uploaded_by_name") @db.VarChar(120)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([buyerOrderId])
  @@index([deletedAt])
  @@map("buyer_order_attachments")
}

model Planning {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `approvalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// System document number for the plan (the workbook has none).
  planNo String @unique @map("plan_no") @db.VarChar(40)

  /// Excel: "Planning Department" (Dropdown -> L_PlanDept)
  planDepartment PlanDepartment @map("plan_department")
  /// Excel: "Container No" (Manual / Dropdown -> L_ContainerNo)
  containerNo    String?        @map("container_no") @db.VarChar(40)
  /// Excel: "Order No" (Dropdown -> Order)
  orderId        String         @map("order_id") @db.Uuid
  order          BuyerOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// ---------------------------------------------------------------------
  ///  WHAT A PLAN IS FOR: ONE LINE OF THE ORDER, NOT THE WHOLE ORDER
  /// ---------------------------------------------------------------------
  ///
  ///  An order carries a line per style / colour / size (C13), and planning is
  ///  done style by style. This plan belongs to exactly one of those lines.
  ///
  ///  Before this column the plan hung off the ORDER, keyed on
  ///  (order, department, version). On a two-style order that meant one cutting
  ///  plan for both styles: it took its `styleNo` from the order header, so it
  ///  named one style, and its `orderQty` from the order header, so it carried
  ///  the OTHER style's quantity as well. The second style could not be planned
  ///  at all - the uniqueness refused a second cutting plan with "Edit or
  ///  revise that plan rather than starting a second one."
  ///
  ///  The line is the right key rather than the style, because a line is
  ///  already (style, colour, size) with its own quantity and its own
  ///  effectiveQty ceiling - which is exactly what the plan has to be measured
  ///  against. MaterialPlan keys on the same thing, for the same reason.
  orderLineId String         @map("order_line_id") @db.Uuid
  orderLine   BuyerOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  /// The line's style, denormalised so a plan can be listed and filtered by
  /// style without joining through the line. Written from the line, never
  /// accepted from a client.
  styleId String @map("style_id") @db.Uuid
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// Excel: "Style No" (Auto) - the style number of THIS PLAN'S line.
  styleNo  String        @map("style_no") @db.VarChar(40)
  /// Excel: "Order Qty" (Auto) - the quantity of THIS PLAN'S line, not the
  /// order's total. The ceiling is the line's effectiveQty.
  orderQty Decimal       @map("order_qty") @db.Decimal(18, 4)
  /// Excel: "Date" on the flat Planning sheet (Auto) - plan preparation date.
  planDate DateTime      @map("plan_date") @db.Date
  /// Excel: "Status" (Auto -> L_StatusGeneral)
  status   StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Text)
  remarks  String?       @db.Text

  /// Approval state of this plan; the decision itself is logged in PlanApproval.
  approvalStatus StatusApproval @default(PENDING) @map("approval_status")
  /// Plan revision, incremented when a rejected plan is resubmitted
  /// ("Revised plan v2" in the Plan Approval sheet).
  version        Int            @default(1)

  // --- Server-calculated allocation ---------------------------------------
  //
  //  Current Process.xlsx -> Planning sheet carries the note
  //  "Sum should match Order Qty". Both totals below are recomputed from the
  //  lines on every write and are never accepted from a client. The ceiling
  //  they are checked against is BuyerOrder.effectiveQty, which already
  //  reflects only the excess the Director actually granted - so a plan can
  //  exceed the plain order quantity exactly as far as an APPROVED excess
  //  allows, and no further.

  /// SERVER-CALCULATED. Sum of deliverableSize across the live plan lines.
  plannedQty        Decimal @default(0) @map("planned_qty") @db.Decimal(18, 4)
  /// SERVER-CALCULATED. Sum of cuttingPcsAllotted across the live plan lines.
  /// Zero on a cutting plan, which allots fabric instead - see below.
  plannedCuttingPcs Decimal @default(0) @map("planned_cutting_pcs") @db.Decimal(18, 4)
  /// SERVER-CALCULATED. Sum of fabricQty across the live plan lines, and the
  /// whole of what a cutting plan commits to issuing.
  plannedFabricQty  Decimal @default(0) @map("planned_fabric_qty") @db.Decimal(18, 4)

  // --- Approval flow ("Approved by Vinay ji (GM) / Dinesh Sir") -----------
  //
  //  A plan with approvalStatus PENDING and no submittedAt is a DRAFT that the
  //  planner is still building. Submitting it stamps submittedAt and opens a
  //  PlanApproval round; the decision comes back here and into that log.

  /// Excel: "Submitted To" on the Plan Approval sheet (-> L_AuthorisedBy).
  submittedTo     String?   @map("submitted_to") @db.VarChar(120)
  /// Null while the plan is a draft.
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedById   String?   @map("submitted_by_id") @db.Uuid
  /// Excel: "Prepared By" on the Plan Approval sheet, e.g. "Vinay ji (GM)".
  submittedByName String?   @map("submitted_by_name") @db.VarChar(120)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  /// Excel: "Rejection Reason" - required whenever approvalStatus is REJECTED.
  rejectionReason String?   @map("rejection_reason") @db.Text

  lines           PlanningLine[]
  planApprovals   PlanApproval[]
  cuttingIssues   CuttingIssue[]
  /// C5 - cutting challans drawn against this planning version.
  cuttingChallans CuttingChallan[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// One plan per (order line, department, version). Was
  /// (order, department, version), which allowed only one plan per order per
  /// department however many styles the order carried.
  @@unique([orderId, planDepartment, orderLineId, version])
  @@index([orderLineId])
  @@index([styleId])
  @@index([orderId])
  @@index([status])
  @@index([approvalStatus])
  @@index([containerNo])
  @@index([submittedAt])
  @@index([deletedAt])
  @@map("plannings")
}

/// C13 - ONE STYLE ON AN ORDER, AND HOW MANY PIECES OF IT.
///
/// ---------------------------------------------------------------------------
///  WHY THIS TABLE EXISTS
///
///  An order in this business carries several styles. The workbook does not -
///  its Order sheet has a single "Style No" dropdown per row - and the ERP
///  reproduced that faithfully, so until C13 a BuyerOrder held one style and
///  one quantity.
///
///  The consequence was not cosmetic. `domain/requirement.js` multiplies a
///  style's per-piece consumption by the order quantity, and that is the ONLY
///  requirement calculation in this application: the PO ceiling, planning, the
///  cutting challan and the material plan all call it. On a two-style order it
///  charged the WHOLE order quantity against the one style named on the
///  header - over-buying that style and buying nothing at all for the other.
///
///  C7 had already met the same gap from the other end and worked around it
///  locally: PlanApproval gained its own `styleId` because "two styles shipping
///  in one container shared a single plan approval". The workaround was applied
///  downstream; the order itself was never fixed. This fixes the order.
///
/// ---------------------------------------------------------------------------
///  THE LINE CARRIES ITS OWN CEILING
///
///  `effectiveQty` is on the LINE, not only on the order, and that is the whole
///  point of the table. It is the line's own quantity plus the excess the
///  Director approved, and it is the figure every requirement must be computed
///  against.
///
///  It is deliberately named to match BuyerOrder's own columns. `requirementFor()`
///  reads `effectiveQty ?? orderQty` off whatever it is handed, so passing a
///  LINE where an order used to go needs no change to the calculation - the
///  seam is the field names, and keeping them identical is what makes the fix
///  a substitution rather than a rewrite.
model BuyerOrderLine {
  id      String     @id @default(uuid()) @db.Uuid
  orderId String     @map("order_id") @db.Uuid
  order   BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// Excel: "Style No" (Dropdown -> Style Master), per line.
  styleId String @map("style_id") @db.Uuid
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// Excel: "Color Code" (Dropdown -> L_ColorCode) and "Size Group", both of
  /// which vary style by style on a real order.
  colorCode String? @map("color_code") @db.VarChar(60)
  sizeGroup String? @map("size_group") @db.VarChar(60)

  /// Finished pieces of THIS style. Typed; the header total is derived from it.
  orderQty Decimal @map("order_qty") @db.Decimal(18, 4)

  /// SERVER-CALCULATED. orderQty x (1 + the APPROVED excess), never the
  /// requested one - so an excess still awaiting a decision buys nothing.
  /// This is the per-style ceiling every requirement is computed against.
  effectiveQty Decimal @map("effective_qty") @db.Decimal(18, 4)

  /// Selling price per piece, in the order's currency. Typed.
  unitPrice Decimal? @map("unit_price") @db.Decimal(18, 4)
  /// SERVER-CALCULATED. orderQty x unitPrice - the ORDERED pieces, never the
  /// excess: the buyer pays for what they asked for, not for our allowance.
  lineValue Decimal? @map("line_value") @db.Decimal(18, 2)

  remarks String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  materialPlans MaterialPlan[]
  plannings     Planning[]

  @@unique([orderId, lineNo])
  /// The same style in the same colour and size twice on one order is not two
  /// lines, it is one line entered twice - and it would double the requirement.
  @@unique([orderId, styleId, colorCode, sizeGroup], name: "order_line_identity")
  @@index([orderId])
  @@index([styleId])
  @@index([deletedAt])
  @@map("buyer_order_lines")
}

/// One day-wise allotment row of a plan.
/// Business rule ("Current Process" -> Planning sheet): the sum of
/// deliverableSize across the lines of a plan must equal Planning.orderQty.
model PlanningLine {
  id         String   @id @default(uuid()) @db.Uuid
  planningId String   @map("planning_id") @db.Uuid
  planning   Planning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// Excel: "Date" (calendar open) - the day this quantity is due.
  lineDate           DateTime @map("line_date") @db.Date
  /// Excel: "Unit" (Dropdown -> L_StitchingUnit), units 1-4.
  unit               String?  @db.VarChar(80)
  /// THE ROW'S ALLOTMENT, IN PIECES: stitching, packing and dispatch.
  ///
  /// Excel calls the column "Deliverable Size", and the office reads that name
  /// as the ORDER quantity - which is why plans arrived with the order total
  /// repeated on every row and were refused for allotting twice what the order
  /// permits. The order quantity is not stored here at all now; it is shown
  /// once at the top of the plan, read from the order line it belongs to.
  ///
  /// What this holds is what that unit is to produce on that date, and the sum
  /// of it is what the workbook's own note - "Sum should match Order Qty" -
  /// has always meant.
  ///
  /// NULL on a cutting plan, which allots fabric instead. See `fabricQty`.
  deliverableSize    Decimal? @map("deliverable_size") @db.Decimal(18, 4)
  /// RETIRED. Excel: "Cutting Pcs alloted" on the flat Planning sheet.
  ///
  /// A plan line carries ONE quantity now, and which one depends on the
  /// department: fabric for cutting, pieces for stitching, packing and
  /// dispatch. This second piece column had no meaning once that was true -
  /// on a stitching plan it duplicated `deliverableSize`, and on a cutting
  /// plan it counted something the floor never receives.
  ///
  /// Kept rather than dropped so plans written before the change still say
  /// what they said. Nothing writes it any more.
  cuttingPcsAllotted Decimal? @map("cutting_pcs_allotted") @db.Decimal(18, 4)

  /// THE ROW'S ALLOTMENT, IN FABRIC: cutting only.
  ///
  /// The fabric to be issued to this unit on this date.
  ///
  /// What goes out to a cutting floor is cloth, measured in metres, and what
  /// comes back is panels. The plan therefore allots what will actually be
  /// handed over - see CuttingIssue.issuedQty, which is the same quantity in
  /// the same unit once it has been.
  ///
  /// NOT bounded by `deliverableSize` the way cutting pieces were: one is
  /// metres and the other is pieces, and the ratio between them is the style's
  /// utilisation, not a rule this table can enforce.
  fabricQty Decimal?      @map("fabric_qty") @db.Decimal(18, 4)
  /// L_UOM. The sheet works in Mtrs; stored per line so a plan in yards reads
  /// as yards rather than being silently re-labelled.
  fabricUom String?       @map("fabric_uom") @db.VarChar(20)
  /// Excel: "Status" (Auto -> L_StatusGeneral)
  status    StatusGeneral @default(PENDING)
  /// Excel: "Remark" (Text)
  remark    String?       @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([planningId, lineNo])
  @@index([planningId])
  @@index([lineDate])
  @@index([deletedAt])
  @@map("planning_lines")
}

// ===========================================================================
//  6. VENDOR QUOTATION + QUOTATION APPROVAL
// ===========================================================================

/// EXCEL SHEET: "Vendor Quotation-Approval"
/// (Role Acess - Procurement Dept (Manager) - Approved by Dinesh Sir)
model VendorQuotation {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `authorisationStatus` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(PENDING_APPROVAL) @map("workflow_state")

  /// Excel: "Quotation No" (Auto) - QT-001
  quotationNo         String         @unique @map("quotation_no") @db.VarChar(40)
  /// Excel: "Date" (Auto)
  quotationDate       DateTime       @map("quotation_date") @db.Date
  /// Excel: "Item" (Dropdown -> L_ItemCategory)
  item                String         @db.VarChar(60)
  /// Sub-category / accessory detail, mirroring the PO sheet, so the approved
  /// quotation can be converted into a PO without re-keying.
  subCategory         String?        @map("sub_category") @db.VarChar(60)
  accessoriesItem     String?        @map("accessories_item") @db.VarChar(80)
  /// Free-text type of the accessory - for a Button, "4-hole horn, 18L"
  accessoryType       String?        @map("accessory_type") @db.VarChar(120)
  /// Excel: "Vendor Name" (Dropdown -> Vendor Master)
  vendorId            String         @map("vendor_id") @db.Uuid
  vendor              Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Excel: "Rate Quoted" (Manual)
  rateQuoted          Decimal        @map("rate_quoted") @db.Decimal(18, 4)
  /// Excel: "UOM" (Dropdown -> L_UOM)
  uom                 String         @db.VarChar(20)
  /// Excel: "Qty" (Manual)
  qty                 Decimal        @db.Decimal(18, 4)
  /// Excel: "Amount" (Formula: Rate x Qty). Stored, recomputed on every write.
  amount              Decimal        @db.Decimal(18, 2)
  /// Excel: "Authorised By" (Auto -> L_AuthorisedBy), e.g. "Dinesh Sir"
  authorisedBy        String?        @map("authorised_by") @db.VarChar(120)
  /// Excel: "Authorisation Status" (Dropdown -> Pending/Approved/Rejected)
  authorisationStatus StatusApproval @default(PENDING) @map("authorisation_status")
  /// Excel: "Remarks" (Text), e.g. "Lowest of 3 quotes"
  remarks             String?        @db.Text
  /// Why the quotation was turned down - required when the status is REJECTED.
  /// The sheet carries only Remarks; a rejection deserves its own reasoned
  /// field, the same as every other decision in this system.
  rejectionReason     String?        @map("rejection_reason") @db.Text

  /// MULTI-LINE: the vendor's quote document this row is one item of. Every
  /// quotation has one - a single-item quote is a document with one line.
  headerId String                @map("header_id") @db.Uuid
  header   VendorQuotationHeader @relation(fields: [headerId], references: [id], onDelete: Restrict)
  lineNo   Int                   @default(1) @map("line_no")

  /// Order this quotation was raised for. The workbook records it in Remarks
  /// ("For B9646IS"); made a real link so the pipeline stays traceable.
  orderId String?     @map("order_id") @db.Uuid
  order   BuyerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Name as printed in the workbook's "Authorised By" column, stamped from
  /// the account that took the decision rather than typed.
  approvedByName String?   @map("approved_by_name") @db.VarChar(120)
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([headerId, lineNo])
  @@index([headerId])
  @@index([vendorId])
  @@index([orderId])
  @@index([authorisationStatus])
  @@index([quotationDate])
  @@index([deletedAt])
  @@map("vendor_quotations")
}

// ===========================================================================
//  7. PURCHASE ORDER + PO APPROVAL
// ===========================================================================

/// EXCEL SHEET: "PO" - PO Format   (Role Acess - Procurement Dept (Manager))
/// Sheet note above "PO ID": "Vendor initial + no"  =>  RF-001, MA-001.
///
/// MULTI-LINE: A ROW OF THIS TABLE IS ONE LINE OF A PURCHASE ORDER. The
/// document the vendor receives is PurchaseOrderHeader. Every per-item control
/// built on this table - the frozen tolerances, the requirement ceiling, the
/// cumulative receipts the GRN judges - is per item, which is why the row
/// stays the line rather than being folded into a header. `poId` is the
/// line's own reference: the header number for line 1 (RF-012), and
/// "RF-012/2", "RF-012/3" for the rest.
model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid

  headerId String              @map("header_id") @db.Uuid
  header   PurchaseOrderHeader @relation(fields: [headerId], references: [id], onDelete: Restrict)
  lineNo   Int                 @default(1) @map("line_no")

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `approvalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(PENDING_APPROVAL) @map("workflow_state")

  /// Excel: "PO ID" (Auto) - vendor initials + running number
  poId            String        @unique @map("po_id") @db.VarChar(40)
  /// Excel: "Date" (Auto)
  poDate          DateTime      @map("po_date") @db.Date
  /// Excel: "Item" (Dropdown -> L_ItemCategory)
  item            String        @db.VarChar(60)
  /// Excel: "sub - category" (Dropdown -> L_FabricSubCat), e.g. "10 oz"
  subCategory     String?       @map("sub_category") @db.VarChar(60)
  /// Excel: "Accessories item" - sheet note: "it will appear only if they
  /// select accessory" (Dropdown -> L_AccessoriesItem)
  accessoriesItem String?       @map("accessories_item") @db.VarChar(80)
  /// Free-text type of the accessory - for a Button, "4-hole horn, 18L"
  accessoryType   String?       @map("accessory_type") @db.VarChar(120)
  /// Excel: "Excess Allowed" - sheet note "2-3%". Fraction (0.02 = 2%).
  /// Process Doc: accessories may be ordered only 1% over requirement.
  excessAllowed   Decimal       @default(0) @map("excess_allowed") @db.Decimal(9, 6)
  /// Excel: "Vender Name" (Dropdown -> Vendor Master)
  vendorId        String        @map("vendor_id") @db.Uuid
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Excel: "Address" (Auto, from Vendor Master; snapshot at PO time)
  address         String?       @db.Text
  /// Excel: "UOM" (Dropdown -> L_UOM)
  uom             String        @db.VarChar(20)
  /// Excel: "Order Qty" (Manual)
  orderQty        Decimal       @map("order_qty") @db.Decimal(18, 4)
  /// Excel: "Rate" (Manual)
  rate            Decimal       @db.Decimal(18, 4)
  /// Excel: "Amount" (Auto: Order Qty x Rate)
  amount          Decimal       @db.Decimal(18, 2)
  /// Excel: "HSN Code" (Manual)
  hsnCode         String?       @map("hsn_code") @db.VarChar(20)
  /// Excel: "GSM" (Dropdown -> L_GSM)
  gsm             String?       @db.VarChar(20)
  /// Excel: "Content" (Text -> L_FabricContent)
  content         String?       @db.VarChar(80)
  /// Excel: "Color code" (Dropdown -> L_ColorCode)
  colorCode       String?       @map("color_code") @db.VarChar(60)
  /// Excel: "Count" (Manual -> L_Count)
  count           String?       @db.VarChar(20)
  /// Excel: "Status" (Dropdown -> L_StatusGeneral)
  status          StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Text) - the workbook writes the order type and order no
  /// here, e.g. "Order as per Style - B9641IS" / "Bulk Order - B9646IS".
  remarks         String?       @db.Text

  /// C1 / Process Doc s.5 - the mode the Remarks column encodes in the sheet.
  ///
  /// NOT NULL and no default. Under AS_PER_STYLE the quantity is capped by
  /// `computedRequirementQty` below; under BULK nothing caps it.
  orderMode PoOrderMode @map("order_mode")

  /// C1: the style requirement this PO was judged against, frozen at creation.
  ///
  /// Persisted rather than recomputed on read, because the BOM is allowed to
  /// change and a ceiling that has already been applied must not move
  /// underneath a document somebody has already signed. Null when nothing
  /// bounded the line - a BULK order with no style, or an item the style says
  /// nothing about.
  computedRequirementQty Decimal? @map("computed_requirement_qty") @db.Decimal(18, 4)

  /// How that requirement was arrived at, in words, snapshotted alongside it.
  /// Without this the stored number is unauditable a year later.
  requirementBasis String? @map("requirement_basis") @db.Text

  /// C1: BULK only. How far this order sits from what the reference style
  /// would have required - measured and recorded, never enforced. Positive is
  /// over-buying. Null when no style was linked for reference.
  bulkVarianceQty Decimal? @map("bulk_variance_qty") @db.Decimal(18, 4)

  // --- C2: CATEGORY AND THE TOLERANCES FROZEN ON THIS DOCUMENT -------------
  //
  //  The tolerance master is date-versioned and will be edited. A purchase
  //  order raised today is received against for weeks afterwards, and the
  //  GRNs that judge those receipts must be judged by the numbers that were
  //  in force when the order was placed - not by whatever the master says on
  //  the day the lorry arrives. So BOTH tolerances are resolved once, at
  //  creation, and stored here.

  /// C2 - the commercial category, resolved from `item` and stored.
  category ItemCategory

  /// The ORDER tolerance this document was judged by, as a fraction.
  orderTolerancePct   Decimal @map("order_tolerance_pct") @db.Decimal(9, 6)
  /// The RECEIPT tolerance every GRN against this order will be judged by,
  /// cumulatively. Frozen here for the reason above.
  receiptTolerancePct Decimal @map("receipt_tolerance_pct") @db.Decimal(9, 6)
  /// The tolerance_rules version both came from, and its basis as it read on
  /// the day. The id alone is not enough - a version can be corrected.
  toleranceRuleId     String? @map("tolerance_rule_id") @db.Uuid
  toleranceBasis      String? @map("tolerance_basis") @db.Text

  /// C2 - THE QUANTITY THAT IS ACTUALLY PAYABLE: what was received, not what
  /// was ordered.
  ///
  /// Maintained by the GRN posting transaction from the receipts themselves
  /// and never typed. Kept beside `receivedQty` rather than folded into it
  /// because they answer different questions: `receivedQty` is a running
  /// fulfilment total that drives the PO's own status, and `payableQty` is
  /// the figure a payment system would settle on. They are equal today by
  /// construction, and a CHECK constraint says so - but the payable figure is
  /// the one with a commercial meaning, and it is named for it.
  ///
  /// C2 - set when an over-tolerance CUMULATIVE receipt was explicitly
  /// accepted by the receiver (grn.create()'s `acknowledgeToleranceBreach`).
  ///
  /// The database ceiling below defers to it, because refusing an
  /// acknowledged over-delivery at the storage layer would retrospectively
  /// invalidate receipts the business decided to take. What the ceiling stops
  /// is an over-receipt landing with nobody having said so.
  receiptBreachAcknowledged Boolean @default(false) @map("receipt_breach_acknowledged")

  /// NO PAYMENT MODULE IS IMPLEMENTED. This column is exposed and nothing in
  /// this system spends it. See the C11 Decision 2 report.
  payableQty Decimal @default(0) @map("payable_qty") @db.Decimal(18, 4)

  /// Buyer order / style this PO procures for (kept in Remarks in the sheet).
  orderId String?     @map("order_id") @db.Uuid
  order   BuyerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  styleId String?     @map("style_id") @db.Uuid
  style   Style?      @relation(fields: [styleId], references: [id], onDelete: SetNull)

  /// Approved quotation this PO was raised from.
  quotationId String?          @map("quotation_id") @db.Uuid
  quotation   VendorQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  /// PO APPROVAL stage.
  approvalStatus  StatusApproval @default(PENDING) @map("approval_status")
  approvedByName  String?        @map("approved_by_name") @db.VarChar(120)
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(3)
  /// When the decision was taken, whichever way it went. approvedAt is null
  /// on a rejection, so without this a refused PO carries no date at all.
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?        @map("rejection_reason") @db.Text

  /// Running receipt totals maintained by the GRN stage.
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  gatePasses GatePass[]
  grns       Grn[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([headerId, lineNo])
  @@index([headerId])
  @@index([vendorId])
  @@index([orderId])
  @@index([quotationId])
  @@index([status])
  @@index([approvalStatus])
  @@index([poDate])
  @@index([orderMode])
  @@index([category])
  @@index([deletedAt])
  @@map("purchase_orders")
}

// ===========================================================================
//  8. GATE PASS
// ===========================================================================

/// EXCEL SHEET: "Gate Pass (Inward / Outward)"
/// (Role Acess - Procurement Dept (Checker))
model GatePass {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `status` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(SUBMITTED) @map("workflow_state")

  /// Excel: "Gate Pass No" (Auto) - GP-001
  gatePassNo      String         @unique @map("gate_pass_no") @db.VarChar(40)
  /// Excel: "Date" (Auto)
  gatePassDate    DateTime       @map("gate_pass_date") @db.Date
  /// Excel: "Type" (Dropdown -> Inward/Outward)
  type            GatePassType
  /// Excel: "Linked PO / Challan No" (Dropdown) - free text as printed
  /// (RF-001, DY-001, CH-001, PR-001, MA-003).
  /// ---------------------------------------------------------------------
  ///  NULL UNTIL THE PASS IS ALLOCATED
  /// ---------------------------------------------------------------------
  ///
  ///  Goods arrive before anybody knows which purchase order they answer. The
  ///  checker at the gate knows two things for certain - WHO delivered and
  ///  WHEN - and is in no position to look up a PO number with a lorry
  ///  standing there. Requiring the document up front meant the pass was
  ///  either written later from memory or the number was guessed.
  ///
  ///  So an INWARD pass may be raised naming only the vendor and the time, and
  ///  the document is attached afterwards by `allocate()`. An OUTWARD pass
  ///  still requires it: goods cannot leave the building without the document
  ///  that says where they are going.
  linkedDocNo     String?        @map("linked_doc_no") @db.VarChar(40)
  /// Resolved link where the referenced document is a Purchase Order.
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  /// Resolved link where the referenced document is a Dye/Print job work issue.
  dyeIssueId      String?        @map("dye_issue_id") @db.Uuid
  dyeIssue        DyeIssue?      @relation(fields: [dyeIssueId], references: [id], onDelete: SetNull)
  /// Resolved link where the referenced document is a Cutting Issue challan.
  cuttingIssueId  String?        @map("cutting_issue_id") @db.Uuid
  cuttingIssue    CuttingIssue?  @relation(fields: [cuttingIssueId], references: [id], onDelete: SetNull)

  /// Excel: "Item" (Dropdown) - "Fabric", "Dyed Fabric", "Cut Panels", "Zipper"
  /// Copied from the linked document, so null until the pass is allocated.
  item                 String?       @db.VarChar(80)
  /// Excel: "Vendor / Unit Name" (Dropdown -> Vendor Master / L_StitchingUnit)
  vendorId             String?       @map("vendor_id") @db.Uuid
  vendor               Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Name as printed, for units that are not vendor-master records.
  partyName            String        @map("party_name") @db.VarChar(150)
  /// Excel: "Qty" (Auto - from the linked document)
  /// From the linked document, so null until the pass is allocated.
  qty                  Decimal?      @db.Decimal(18, 4)
  /// Excel: "Received Qty" (Manual)
  receivedQty          Decimal?      @map("received_qty") @db.Decimal(18, 4)
  /// Excel: "Variation %" (Auto = IFERROR((Qty - Received Qty)/Qty, 0))
  variationPct         Decimal       @default(0) @map("variation_pct") @db.Decimal(9, 6)
  /// Excel: "UOM" (Auto -> L_UOM)
  uom                  String?       @db.VarChar(20)
  /// Excel: "Purpose" (Dropdown -> L_Purpose)
  purpose              IssuePurpose?
  /// The vehicle the goods crossed the gate on.
  ///
  /// Optional, because it is not always knowable - goods carried in by hand, a
  /// courier whose number the checker never sees - and a required field the
  /// gate cannot fill is a field the gate fills with rubbish. But it is the
  /// first thing anybody asks for when a consignment is disputed, so it is
  /// recorded here rather than buried in `remarks`.
  vehicleNo            String?       @map("vehicle_no") @db.VarChar(30)
  /// Who was driving it.
  ///
  /// Optional for the same reason as the vehicle: goods carried in by hand
  /// have no driver, and a required field the gate cannot fill is a field the
  /// gate fills with rubbish. But when a consignment is disputed the number
  /// plate identifies the lorry and this identifies the person who signed for
  /// it, which is the pair a guard is actually asked to produce.
  driverName           String?       @map("driver_name") @db.VarChar(120)
  /// Excel: "Authorised By" (Auto -> L_AuthorisedBy / employee name)
  authorisedBy         String?       @map("authorised_by") @db.VarChar(120)
  /// The Employee Master record behind that name, where there is one. The
  /// sheet prints a name; a gate pass is the document a guard acts on, so
  /// who authorised it is worth resolving to a real person.
  authorisedEmployeeId String?       @map("authorised_employee_id") @db.Uuid
  authorisedEmployee   Employee?     @relation(fields: [authorisedEmployeeId], references: [id], onDelete: SetNull)
  /// C8 - WHEN THE GOODS ACTUALLY CROSSED THE GATE.
  ///
  /// Different from `createdAt`, and that difference is the whole point: a
  /// lorry cleared at 21:40 is routinely written up the next morning, and a
  /// stage-timing report built on record-creation time would say the goods
  /// waited overnight at the gate when they did not.
  ///
  /// Required on both directions - inward and outward - and refused if it is
  /// in the future, by the service AND by the
  /// `gate_passes_movement_time_not_future` trigger. A CHECK constraint
  /// cannot do it: `now()` is not immutable and PostgreSQL will not accept it
  /// in a CHECK.
  ///
  /// NULLABLE ONLY FOR HISTORY. The eight gate passes that predate C8 have no
  /// record of when the lorry actually crossed, and nothing in the data to
  /// reconstruct it from - `created_at` is when the clerk typed it up, which is
  /// precisely the number C8 exists to stop standing in for the movement.
  /// Inventing one would put a fabricated timestamp on a gate record a dispute
  /// might later turn on; they are listed for manual review instead.
  /// `gate_passes_new_rows_need_movement_time` makes the column mandatory for
  /// every row created after the migration.
  movementTime         DateTime?     @map("movement_time") @db.Timestamptz(3)

  /// When the document was attached, and by whom. An unallocated pass is
  /// outstanding work - this is what says it has been dealt with.
  allocatedAt     DateTime? @map("allocated_at") @db.Timestamptz(3)
  allocatedById   String?   @map("allocated_by_id") @db.Uuid
  allocatedByName String?   @map("allocated_by_name") @db.VarChar(120)

  /// Excel: "Status" (Dropdown -> Pending/Cleared)
  status        StatusGatePass @default(PENDING)
  /// Who closed the gate pass off, and when. A cleared pass is the evidence
  /// the goods actually moved, so the clearing is stamped, not typed.
  clearedAt     DateTime?      @map("cleared_at") @db.Timestamptz(3)
  clearedById   String?        @map("cleared_by_id") @db.Uuid
  clearedByName String?        @map("cleared_by_name") @db.VarChar(120)
  /// Excel: "Remarks" (Text)
  remarks       String?        @db.Text

  grns Grn[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([type])
  @@index([status])
  @@index([gatePassDate])
  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([authorisedEmployeeId])
  @@index([linkedDocNo])
  @@index([movementTime])
  @@index([deletedAt])
  @@map("gate_passes")
}

// ===========================================================================
//  9. GRN (GOODS RECEIPT NOTE)
// ===========================================================================

/// EXCEL SHEET: "GRN" - GRNFormat   (Role Acess - Procurement Dept (Checker))
///
/// Receipt tolerance (Process Doc s.5): a 2% excess variation is accepted on
/// material generally, accessories may be received up to 3% in excess and no
/// more, and payment is made on the quantity actually received.
model Grn {
  id String @id @default(uuid()) @db.Uuid

  /// MULTI-LINE: the receipt document this row is one line of - one vendor
  /// bill, one delivery. Each line receives against one PO line, keeps its
  /// own rolls, ledger entries and tolerance judgement.
  headerId String    @map("header_id") @db.Uuid
  header   GrnHeader @relation(fields: [headerId], references: [id], onDelete: Restrict)
  lineNo   Int       @default(1) @map("line_no")

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `status` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(POSTED) @map("workflow_state")

  /// System GRN number. The workbook identifies a receipt by PO ID + Bill No;
  /// the ERP additionally issues its own sequential number for traceability.
  grnNo String @unique @map("grn_no") @db.VarChar(40)

  /// Excel: "PO ID" (Dropdown -> PO)
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  /// Excel: "Bill No" (Manual) - vendor invoice / bill number
  billNo          String        @map("bill_no") @db.VarChar(60)
  /// Excel: "Roll No" (Manual) - printed roll reference for single-roll receipts.
  /// Individual rolls are created as FabricRoll records linked back to this GRN.
  rollNo          String?       @map("roll_no") @db.VarChar(40)
  /// Excel: "Date" (Auto)
  grnDate         DateTime      @map("grn_date") @db.Date
  /// Excel: "purpose" (Dropdown -> L_GRNPurpose)
  purpose         GrnPurpose
  /// Excel: "Item" (Auto, from PO)
  item            String        @db.VarChar(80)
  /// Excel: "HSN Code" (Auto, from PO)
  hsnCode         String?       @map("hsn_code") @db.VarChar(20)
  /// Excel: "Vender" (Auto, from PO)
  vendorId        String        @map("vendor_id") @db.Uuid
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Excel: "UOM" (Auto)
  uom             String        @db.VarChar(20)
  /// Excel: "Order Qty" (Auto, from PO)
  orderQty        Decimal       @map("order_qty") @db.Decimal(18, 4)
  /// Excel: "Receiving Qty" (Manual)
  receivingQty    Decimal       @map("receiving_qty") @db.Decimal(18, 4)
  /// Excel: "Inventory Rate" (Formula) - rate at which stock is valued.
  inventoryRate   Decimal       @map("inventory_rate") @db.Decimal(18, 4)
  /// Excel: "Amount" (Auto = Receiving Qty x Inventory Rate)
  /// This is the TAXABLE VALUE on the purchase invoice.
  amount          Decimal       @db.Decimal(18, 2)

  // --- GST on the vendor's bill ------------------------------------------
  //
  // Not in the workbook, which records no tax at all. Added because a receipt
  // has to reproduce the bill the vendor actually sent, and that bill carries
  // GST. Nullable throughout: a GRN raised before the rate is known, or from an
  // unregistered vendor, simply has no tax on it and prints saying so.

  /// A FRACTION, not a percentage: 0.05 is five percent. Chosen from the
  /// "GST Rate" master list, never defaulted by the application.
  gstRatePct   Decimal?    @map("gst_rate_pct") @db.Decimal(7, 6)
  /// Resolved at posting from the vendor GSTIN, then frozen.
  supplyType   SupplyType? @map("supply_type")
  /// The vendor GSTIN as it stood when the receipt was posted.
  vendorGstin  String?     @map("vendor_gstin") @db.VarChar(20)
  cgstAmount   Decimal     @default(0) @map("cgst_amount") @db.Decimal(18, 2)
  sgstAmount   Decimal     @default(0) @map("sgst_amount") @db.Decimal(18, 2)
  igstAmount   Decimal     @default(0) @map("igst_amount") @db.Decimal(18, 2)
  /// amount + cgst + sgst + igst, as the sum of the ROUNDED parts.
  invoiceTotal Decimal?    @map("invoice_total") @db.Decimal(18, 2)

  /// Excel: "Status" (Dropdown -> L_StatusGeneral)
  status  StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Text)
  remarks String?       @db.Text

  /// Receipt variance against the PO quantity, as a fraction.
  /// (Receiving Qty - Order Qty) / Order Qty. Positive = excess received.
  variationPct      Decimal @default(0) @map("variation_pct") @db.Decimal(9, 6)
  /// True when the CUMULATIVE receipt against the purchase order breaches
  /// the receipt tolerance frozen on that order. C2: the comparison is
  ///
  ///     SUM(every receipt against the PO line)  >  poQty x (1 + tolerance)
  ///
  /// and never this receipt on its own - three deliveries of 1% each are a
  /// 3% over-delivery, and a per-GRN test would wave all three through.
  toleranceBreached Boolean @default(false) @map("tolerance_breached")

  // --- C2: WHAT THIS RECEIPT WAS JUDGED BY ---------------------------------

  /// The commercial category, snapshotted from the purchase order.
  category ItemCategory

  /// The receipt tolerance applied, as a fraction. Copied from the purchase
  /// order, which froze it at creation - NOT re-resolved here, or a master
  /// edited between order and delivery would change the rules mid-flight.
  receiptTolerancePct Decimal @map("receipt_tolerance_pct") @db.Decimal(9, 6)

  /// The cumulative received quantity this receipt brought the order to, and
  /// the cumulative variance that produced. Stored so the decision is
  /// auditable without re-summing history that has since been soft-deleted.
  cumulativeReceivedQty  Decimal @default(0) @map("cumulative_received_qty") @db.Decimal(18, 4)
  cumulativeVariationPct Decimal @default(0) @map("cumulative_variation_pct") @db.Decimal(9, 6)

  /// The workbook has no such column - it has no inventory sheet at all.
  /// Where the goods were put, so the roll, the ledger entry and the balance
  /// agree on one location rather than each assuming the main store.
  location String @default("MAIN STORE") @db.VarChar(80)

  /// The stock-keeping item this receipt stocked. Resolved (or created) in
  /// the posting transaction, so a GRN always names the item it moved.
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// The moment GRN + Fabric Roll + Stock Ledger IN were committed together.
  /// Non-null is the proof the receipt reached stock: the three writes share
  /// one transaction, so this is set for all of them or set for none.
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(3)
  postedById   String?   @map("posted_by_id") @db.Uuid
  postedByName String?   @map("posted_by_name") @db.VarChar(120)

  /// Gate Pass the goods physically entered on.
  gatePassId String?   @map("gate_pass_id") @db.Uuid
  gatePass   GatePass? @relation(fields: [gatePassId], references: [id], onDelete: SetNull)

  /// F-04 - WHEN THIS RECEIPT WAS UNDONE.
  ///
  /// Stamped by the reversal at the moment it posts its counter-movements.
  /// The receipt itself is NOT rewritten: `workflowState` stays POSTED and
  /// `status` stays COMPLETED, because both are true - it WAS posted, and the
  /// goods DID arrive. What changed is that an equal and opposite set of
  /// movements now stands beside it, exactly as a credit note stands beside an
  /// invoice rather than erasing it.
  ///
  /// Anything counting live receipts filters on `reversedAt: null`.
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedById   String?   @map("reversed_by_id") @db.Uuid
  reversedByName String?   @map("reversed_by_name") @db.VarChar(120)

  rolls       FabricRoll[]
  stockLedger StockLedger[]
  reversals   GrnReversal[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([headerId, lineNo])
  @@index([headerId])
  /// F-04 - ONE BILL PER PO, AMONG THE RECEIPTS THAT STILL STAND.
  ///
  /// This was a plain `@@unique([purchaseOrderId, billNo])`, which is the
  /// right rule and the wrong scope: it counted soft-deleted and reversed
  /// receipts too. That made the reversal useless for the case it exists for -
  /// a storeman keys bill 12345 as 1,000 m instead of 100, reverses it, and
  /// then cannot re-enter bill 12345 correctly because the wrong receipt is
  /// still holding the number.
  ///
  /// The rule is now a PARTIAL unique index, created in raw SQL by the F-04
  /// migration because Prisma cannot express a WHERE clause on an index:
  ///
  ///   CREATE UNIQUE INDEX grns_live_bill_per_po
  ///     ON grns (purchase_order_id, bill_no)
  ///     WHERE deleted_at IS NULL AND reversed_at IS NULL;
  ///
  /// Declared here as a plain index so the Prisma client still plans lookups
  /// on the pair. The uniqueness is the database's, not this file's - and
  /// grn.service.js checks it in the same terms before writing, so the caller
  /// gets a sentence rather than a constraint violation.
  @@index([purchaseOrderId, billNo])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([grnDate])
  @@index([status])
  @@index([inventoryItemId])
  @@index([billNo])
  @@index([category])
  @@index([deletedAt])
  @@index([reversedAt])
  @@map("grns")
}

/// ===========================================================================
///  F-04 - GRN REVERSAL. The compensating document a posted receipt is
///  corrected by.
/// ===========================================================================
///
///  ---------------------------------------------------------------------------
///   THE HOLE THIS FILLS
///
///   A GRN posts to stock inside its own create transaction - there is no
///   separate post step, and `postedAt` is stamped the moment the receipt is
///   saved. From then on `setStatus()` refused cancellation and `remove()`
///   refused deletion, both telling the user in as many words that "a posted
///   receipt is corrected by a reversal, not by a status change".
///
///   No reversal existed. Not a route, not a service, not a column. A storeman
///   who keyed 1,000 m instead of 100, or picked the wrong PO, or fat-fingered
///   the rate, had committed that to the ledger the instant they pressed save,
///   and the only way back was SQL against production. The error message named
///   a remedy the application did not have.
///
///  ---------------------------------------------------------------------------
///   WHY A SEPARATE TABLE AND NOT A NEGATIVE GRN
///
///   The obvious shape is "another GRN row with the quantity negated". The
///   `grns` table refuses it, and rightly: `grns_receiving_qty_non_negative`,
///   `grns_amount_is_qty_x_rate`, `grns_variation_is_the_formula` and
///   `grns_cumulative_covers_this_receipt` are all written for a receipt of
///   goods, and a negative one satisfies none of them. Loosening four CHECK
///   constraints so one row can lie about being a receipt would cost the
///   protection they give the other ten thousand rows.
///
///   A reversal is also not a receipt in any other sense. It has a reason, it
///   has an approver, and it has no vendor bill, no tolerance assessment and
///   no GST - the bill it undoes is the one already on the GRN. Modelling it
///   as its own document is what lets it carry those and only those.
///
///  ---------------------------------------------------------------------------
///   FULL REVERSAL ONLY
///
///   One reversal undoes one receipt in its entirety. There is deliberately no
///   partial reversal: a receipt that is wrong is re-keyed, and "reverse 900 of
///   the 1,000" raises questions - which rolls, at what rate, does the
///   tolerance re-assess, what does the PO's payable quantity become - whose
///   answers would each be a decision this document is not equipped to record.
///   Reverse it and enter it again is one rule with one answer.
///
///   The partial unique index below is what makes "one" true: at most one
///   reversal per GRN that has not been rejected or cancelled.
///
///  ---------------------------------------------------------------------------
///   IT IS APPROVED, AND NOT BY THE PERSON WHO RAISED IT
///
///   `separateChecker: true` in the approval engine's registry. Reversing a
///   receipt moves stock and moves the purchase order's payable quantity; it is
///   the one document in this system whose whole purpose is to undo somebody
///   else's committed work, and a storeman who can post a receipt and then
///   quietly un-post it has no maker-checker at all.
///
///   Approving it POSTS it, in the same transaction. An approved-but-unposted
///   reversal would be a state in which the ledger is still wrong and somebody
///   has to remember to finish the job - which is the failure this document
///   exists to end, reintroduced one step later.
/// ===========================================================================
model GrnReversal {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. DRAFT -> SUBMITTED -> PENDING_APPROVAL -> APPROVED -> POSTED.
  ///
  /// This is the AUTHORITY. `approvalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition. Nothing writes one without the
  /// other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Auto document number - GRV-0001. Its own counter, not the GRN's: a
  /// reversal is not a receipt and must not consume a receipt number.
  reversalNo   String   @unique @map("reversal_no") @db.VarChar(40)
  reversalDate DateTime @map("reversal_date") @db.Date

  /// The receipt being undone. RESTRICT, not CASCADE: a reversal without the
  /// receipt it reverses is a movement nobody can explain.
  grnId String @map("grn_id") @db.Uuid
  grn   Grn    @relation(fields: [grnId], references: [id], onDelete: Restrict)

  /// WHY. Required, and required to be a sentence rather than a keystroke -
  /// see the CHECK constraint in the migration. The whole document is an
  /// admission that something was recorded wrongly, and a year later the only
  /// person who can say what will be this field.
  reason String @db.Text

  /// WHAT IT UNDOES, FROZEN AT CREATION.
  ///
  /// Copied off the GRN rather than read through the relation, for the reason
  /// every other document in this schema freezes its figures: the reversal is
  /// a statement about a quantity, and it must still say what it reversed
  /// after somebody edits the receipt's descriptive fields underneath it.
  ///
  /// They are also what the posting checks against. If the receipt's figures
  /// and these ever disagree, the reversal refuses to post rather than moving
  /// a quantity nobody authorised.
  reversedQty    Decimal @map("reversed_qty") @db.Decimal(18, 4)
  reversedAmount Decimal @map("reversed_amount") @db.Decimal(18, 2)
  uom            String  @db.VarChar(20)
  /// Where the goods were put by the receipt, and where they are taken from.
  location       String  @db.VarChar(80)

  /// The stock item the counter-movements are posted against. Nullable only
  /// because the GRN's own `inventoryItemId` is - in practice a posted receipt
  /// always has one (`grns_posted_has_item`), and a reversal of anything else
  /// is refused before it is created.
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// How many fabric rolls this reversal writes off. Zero for a lot receipt.
  /// Stored so the approver sees the size of what they are signing without the
  /// screen having to count rows.
  rollCount Int @default(0) @map("roll_count")

  /// Approval state, kept in step with `workflowState` by the engine.
  approvalStatus StatusApproval @default(PENDING) @map("approval_status")

  submittedTo     String?   @map("submitted_to") @db.VarChar(120)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedById   String?   @map("submitted_by_id") @db.Uuid
  submittedByName String?   @map("submitted_by_name") @db.VarChar(120)

  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Required whenever approvalStatus is REJECTED.
  rejectionReason String?   @map("rejection_reason") @db.Text

  /// The moment the counter-movements reached the ledger. Non-null is the
  /// proof the reversal actually took effect: the movements, the roll
  /// write-off, the purchase order's payable quantity and this stamp share one
  /// transaction, so it is set for all of them or set for none.
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(3)
  postedById   String?   @map("posted_by_id") @db.Uuid
  postedByName String?   @map("posted_by_name") @db.VarChar(120)

  remarks String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// AT MOST ONE LIVE REVERSAL PER RECEIPT.
  ///
  /// Enforced as a partial unique index in raw SQL by the F-04 migration,
  /// because "live" means `deleted_at IS NULL AND workflow_state NOT IN
  /// ('REJECTED', 'CANCELLED')` and Prisma cannot express that here. A
  /// rejected reversal must not block a corrected one being raised.
  @@index([grnId])
  @@index([workflowState])
  @@index([reversalDate])
  @@index([inventoryItemId])
  @@index([deletedAt])
  @@map("grn_reversals")
}

// ===========================================================================
//  10. FABRIC ROLL
// ===========================================================================

/// A physical fabric roll, identified by the "Roll No" / "Fabric No" (FAB-001)
/// that the Fabric Issue, Dye issue, Dyeing Receipt and Fabric Scrutiny sheets
/// all key on. Created at GRN and followed to Cutting Issue.
model FabricRoll {
  id String @id @default(uuid()) @db.Uuid

  /// Excel: "Roll No" / "Fabric No" - FAB-001
  ///
  /// F-04 - UNIQUE, BUT ONLY AMONG ROLLS THAT HAVE NOT BEEN WRITTEN OFF.
  ///
  /// This was a plain `@unique`. It is now a PARTIAL unique index created in
  /// raw SQL by the F-04 migration - `WHERE written_off_at IS NULL` - because
  /// Prisma cannot express a WHERE clause on an index. Declared here as a
  /// plain indexed column so the client still plans lookups on it; the
  /// uniqueness is the database's. See `writtenOffAt` below for why.
  rollNo String @map("roll_no") @db.VarChar(40)

  /// GRN the roll was received on.
  grnId    String? @map("grn_id") @db.Uuid
  grn      Grn?    @relation(fields: [grnId], references: [id], onDelete: SetNull)
  /// Supplying vendor.
  vendorId String? @map("vendor_id") @db.Uuid
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// Excel: "Fabric name" on Fabric Issue, e.g. "10 oz 10x6", "Jute Canvas".
  fabricName   String?  @map("fabric_name") @db.VarChar(120)
  /// Excel: "Colour Code" (L_ColorCode)
  colorCode    String?  @map("color_code") @db.VarChar(60)
  /// Excel: "Content" (L_FabricContent)
  content      String?  @db.VarChar(80)
  /// Excel: "Count" (L_Count)
  count        String?  @db.VarChar(20)
  /// Excel: "Construction" (L_Construction)
  construction String?  @db.VarChar(20)
  /// Excel: "Width" (Dye issue, in inches)
  width        Decimal? @db.Decimal(10, 2)
  /// Excel: "GSM" (L_GSM)
  gsm          String?  @db.VarChar(20)
  /// Excel: "UOM" (L_UOM)
  uom          String   @default("Mtrs") @db.VarChar(20)

  /// Quantity as received at GRN.
  receivedQty Decimal  @map("received_qty") @db.Decimal(18, 4)
  /// Quantity currently on hand for this roll.
  balanceQty  Decimal  @map("balance_qty") @db.Decimal(18, 4)
  /// Valuation rate carried from the GRN inventory rate.
  rate        Decimal? @db.Decimal(18, 4)

  /// Where the roll currently sits in the in-scope pipeline.
  stage    RollStage @default(RAW)
  /// Physical store / floor location.
  location String?   @db.VarChar(80)
  /// Held back after an out-of-tolerance dyeing return or a scrutiny reject.
  isHeld   Boolean   @default(false) @map("is_held")
  remarks  String?   @db.Text

  // --- SHADE AND DYE LOT ----------------------------------------------------
  //
  //  Two rolls of "Natural 10 oz" are not interchangeable on one bag. Cloth
  //  dyed in different batches differs in shade by a margin the buyer's QC
  //  will see across a seam, so the front panel, back panel and gusset of one
  //  bag must come from the same shade. These two fields are how the system
  //  knows, and FabricIssue refuses to mix them on one cutting challan line
  //  without a recorded reason (domain/shade.js).
  //
  //  Both are optional: a roll nobody has graded is honestly "unknown", and
  //  guessing a shade is how two batches end up in one bundle.

  /// The shade band the roll was graded into - "A", "B", "S1". Uppercased.
  shade             String?   @db.VarChar(20)
  /// The dye house's batch / lot number, from the mill's packing list at GRN
  /// or the job worker's challan when the roll comes back from dyeing.
  dyeLot            String?   @map("dye_lot") @db.VarChar(40)
  /// Who last graded it, and when - a shade is a judgement somebody made.
  shadeMarkedAt     DateTime? @map("shade_marked_at") @db.Timestamptz(3)
  shadeMarkedByName String?   @map("shade_marked_by_name") @db.VarChar(120)

  /// F-04 - THE ROLL RECORD WAS WRITTEN OFF BY A GRN REVERSAL.
  ///
  /// Distinct from `deletedAt`, and the distinction is the whole point.
  ///
  /// "A roll number is never reused" is a deliberate rule - a deleted roll
  /// keeps its number, and `assertRollNoAvailable()` says so in as many words.
  /// A reversal is its one genuine exception. FAB-0123 is a label printed on a
  /// physical roll of cloth sitting on a rack. If the receipt that booked it in
  /// said 1,000 metres when the roll holds 100, the reversal writes the ROLL
  /// RECORD off - but the cloth and its label are still there, and re-keying
  /// the receipt correctly has to be able to say FAB-0123 again. Refusing would
  /// leave the store holding a roll it cannot enter under its own number, which
  /// is a worse lie than the one the reversal corrected.
  ///
  /// So this column, and not `deletedAt`, is what the partial unique index on
  /// `rollNo` is conditioned on. A roll deleted for any other reason still
  /// holds its number, exactly as before. Both are set together by the
  /// reversal: the row is soft-deleted so it leaves every live-roll query, and
  /// stamped here so its label goes back into circulation.
  writtenOffAt DateTime? @map("written_off_at") @db.Timestamptz(3)

  /// A REMNANT: end-bits a cutting issue put back into stock, booked as a roll
  /// of their own so they can be issued again through the ordinary Fabric
  /// Issue. Numbered after the roll they were cut from (FAB-0123-R1) and
  /// linked to it, so the cloth still traces to the receipt that bought it.
  isRemnant    Boolean      @default(false) @map("is_remnant")
  parentRollId String?      @map("parent_roll_id") @db.Uuid
  parentRoll   FabricRoll?  @relation("RollRemnants", fields: [parentRollId], references: [id], onDelete: SetNull)
  remnants     FabricRoll[] @relation("RollRemnants")

  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  fabricIssues    FabricIssue[]
  dyeIssues       DyeIssue[]
  dyeingReceipts  DyeingReceipt[]
  scrutinies      FabricScrutiny[]
  /// C4 - individual defect findings recorded against this roll.
  scrutinyDefects FabricScrutinyDefect[]
  stockLedger     StockLedger[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([rollNo])
  @@index([grnId])
  @@index([vendorId])
  @@index([stage])
  @@index([colorCode])
  @@index([shade])
  @@index([dyeLot])
  @@index([deletedAt])
  @@index([writtenOffAt])
  @@index([parentRollId])
  @@map("fabric_rolls")
}

// ===========================================================================
//  11. INVENTORY + STOCK LEDGER
// ===========================================================================

/// A stock-keeping item. The workbook has no inventory sheet - stock is
/// implied by GRN in and Fabric/Cutting Issue out - so this master is derived
/// from the item-defining columns that PO and GRN share.
model InventoryItem {
  id String @id @default(uuid()) @db.Uuid

  /// Auto item code, e.g. ITM-0001.
  itemCode    String @unique @map("item_code") @db.VarChar(40)
  /// Printable description as it should read on an issue slip.
  description String @db.VarChar(200)

  /// L_ItemCategory - the workbook's own open dropdown, kept verbatim.
  itemCategory String @map("item_category") @db.VarChar(60)

  /// C2 - THE COMMERCIAL CATEGORY. Exactly one, enum-backed, NOT NULL.
  ///
  /// `itemCategory` above is the workbook's dropdown and users keep adding to
  /// it; this is the closed three-value list every tolerance is keyed on.
  /// Derived from `itemCategory` by `categoryOf()` at write time and STORED,
  /// because a later edit to the open list must not silently re-categorise an
  /// item that tolerances have already been resolved against.
  ///
  /// No default. Which category an item is in decides what may be ordered and
  /// received against it, which is too consequential to be inherited by
  /// omission - the same reasoning C1 applied to `purchase_orders.order_mode`.
  category ItemCategory

  /// L_FabricSubCat
  subCategory     String  @default("") @map("sub_category") @db.VarChar(60)
  /// L_AccessoriesItem
  accessoriesItem String  @default("") @map("accessories_item") @db.VarChar(80)
  /// L_AccessoryVariety. Part of the identity: 18L horn buttons and 24L
  /// metal buttons in the same colour are two stock items with two balances,
  /// not one "Button" balance nobody can issue from correctly. Empty for
  /// fabric and for accessories received before varieties existed.
  accessoryType   String  @default("") @map("accessory_type") @db.VarChar(120)
  /// L_ColorCode
  colorCode       String  @default("") @map("color_code") @db.VarChar(60)
  /// L_FabricContent
  content         String? @db.VarChar(80)
  /// L_GSM
  gsm             String  @default("") @db.VarChar(20)
  /// L_Count
  count           String  @default("") @db.VarChar(20)
  /// L_UOM
  uom             String  @db.VarChar(20)
  hsnCode         String? @map("hsn_code") @db.VarChar(20)

  /// Whether stock of this item is tracked roll-by-roll (fabric) or in bulk.
  isRollTracked Boolean @default(false) @map("is_roll_tracked")
  /// Reorder level used by the inventory report.
  reorderLevel  Decimal @default(0) @map("reorder_level") @db.Decimal(18, 4)
  isActive      Boolean @default(true) @map("is_active")

  rolls         FabricRoll[]
  balances      StockBalance[]
  ledger        StockLedger[]
  grns          Grn[]
  /// F-04 - the reversals that took this item's receipts back out of stock.
  grnReversals  GrnReversal[]
  fabricIssues  FabricIssue[]
  /// C3 - job work lots issued out of this item's stock.
  dyeIssues     DyeIssue[]
  /// C6 - cutting challans that consumed this item off the cutting floor.
  cuttingIssues CuttingIssue[]
  /// FIFO - the cost layers this item's stock is held at.
  costLayers    StockCostLayer[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([itemCategory, subCategory, accessoriesItem, accessoryType, colorCode, gsm, count, uom], name: "inventory_item_identity")
  @@index([itemCategory])
  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("inventory_items")
}

/// Current on-hand quantity per item per location.
///
/// A CACHE, not the truth. Every column here is recomputed by aggregating
/// StockLedger for the same (item, location) inside the transaction that wrote
/// the movement. Nothing in the application adds to or subtracts from these
/// numbers directly, so they cannot drift: at worst they can be rebuilt.
model StockBalance {
  id     String        @id @default(uuid()) @db.Uuid
  itemId String        @map("item_id") @db.Uuid
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  location     String  @default("MAIN STORE") @db.VarChar(80)
  qty          Decimal @default(0) @db.Decimal(18, 4)
  /// Weighted average valuation rate.
  avgRate      Decimal @default(0) @map("avg_rate") @db.Decimal(18, 4)
  value        Decimal @default(0) @db.Decimal(18, 2)
  /// Quantity issued out but not yet consumed/returned (at dyeing, at printing).
  inProcessQty Decimal @default(0) @map("in_process_qty") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([itemId, location])
  @@index([itemId])
  @@map("stock_balances")
}

/// Every stock movement in the in-scope pipeline: GRN receipt in, Fabric Issue
/// out, Dye/Print issue out, Dyeing Receipt in, Scrutiny reject out, Cutting
/// Issue out.
///
/// APPEND-ONLY, AND THE SOURCE OF TRUTH FOR STOCK.
///
/// StockBalance is a cache derived from these rows and nothing else - it is
/// recomputed by aggregating this table inside the same transaction as the
/// movement, never incremented in place from a number a caller supplied. If
/// the two ever disagree, this table is right.
///
/// The item-describing columns below (category, colour, GSM, content, UOM) are
/// deliberate snapshots rather than joins. A ledger is a historical record: it
/// has to keep reading the way it read on the day, even after the inventory
/// master is edited underneath it.
model StockLedger {
  id String @id @default(uuid()) @db.Uuid

  entryDate DateTime @map("entry_date") @db.Date

  itemId String        @map("item_id") @db.Uuid
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  rollId String?     @map("roll_id") @db.Uuid
  roll   FabricRoll? @relation(fields: [rollId], references: [id], onDelete: SetNull)

  location String @default("MAIN STORE") @db.VarChar(80)

  // --- Snapshot of what moved, as it read on the day ----------------------
  /// L_ItemCategory
  itemCategory String  @default("") @map("item_category") @db.VarChar(60)
  /// L_ColorCode
  colorCode    String? @map("color_code") @db.VarChar(60)
  /// L_GSM
  gsm          String? @db.VarChar(20)
  /// L_FabricContent
  content      String? @db.VarChar(80)
  /// L_UOM
  uom          String  @default("") @db.VarChar(20)

  /// Buyer order the movement was made for, where the document names one.
  /// Lets stock be reported per order without walking back up the chain.
  orderId String?     @map("order_id") @db.Uuid
  order   BuyerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Source document.
  documentType DocumentType @map("document_type")
  documentId   String       @map("document_id") @db.Uuid
  documentNo   String       @map("document_no") @db.VarChar(60)

  direction  StockDirection
  /// Signed magnitude of the movement. Always positive; `direction` carries
  /// the sign, and qtyIn / qtyOut below split it into the two columns a stock
  /// register is read in.
  qty        Decimal        @db.Decimal(18, 4)
  /// Excel-style In / Out columns. Exactly one of the two is non-zero, and a
  /// CHECK constraint keeps both agreeing with `direction` and `qty`, so a
  /// SUM(qty_in) - SUM(qty_out) is always the balance.
  qtyIn      Decimal        @default(0) @map("qty_in") @db.Decimal(18, 4)
  qtyOut     Decimal        @default(0) @map("qty_out") @db.Decimal(18, 4)
  rate       Decimal        @default(0) @db.Decimal(18, 4)
  value      Decimal        @default(0) @db.Decimal(18, 2)
  /// Running on-hand balance for (item, location) after this entry.
  balanceQty Decimal        @map("balance_qty") @db.Decimal(18, 4)

  /// Convenience back-link for the GRN receipts that open the ledger.
  grnId String? @map("grn_id") @db.Uuid
  grn   Grn?    @relation(fields: [grnId], references: [id], onDelete: SetNull)

  remarks String? @db.Text

  /// FIFO - the layers an IN opened, and the layers an OUT consumed.
  openedLayers StockCostLayer[]        @relation("LayerSource")
  consumptions StockLayerConsumption[] @relation("LayerConsumption")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?  @map("created_by_id") @db.Uuid
  /// Who moved the stock, as a name. A ledger has to stay readable after the
  /// user account behind the movement is renamed or disabled.
  createdByName String?  @map("created_by_name") @db.VarChar(120)

  @@index([itemId, entryDate])
  @@index([itemId, location])
  @@index([rollId])
  @@index([orderId])
  @@index([documentType, documentId])
  @@index([entryDate])
  @@map("stock_ledger")
}

// ===========================================================================
//  12. FABRIC ISSUE
// ===========================================================================

/// EXCEL SHEET: "Fabric Issue" - Fabric Issue for Cutting Format
/// (Role Acess - Cutting Dept (Supervisor))
/// Purpose routes the roll onward: Dyeing -> DyeIssue, Printing -> DyeIssue /
/// Printing, Cutting -> CuttingIssue.
model FabricIssue {
  id String @id @default(uuid()) @db.Uuid

  /// System document number (the sheet has none; rows are keyed by Roll No).
  issueNo String @unique @map("issue_no") @db.VarChar(40)

  /// Excel: "Date" (Auto)
  issueDate          DateTime      @map("issue_date") @db.Date
  /// Excel: "Vendor" - job worker the fabric goes to, when purpose is job work.
  vendorId           String?       @map("vendor_id") @db.Uuid
  vendor             Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Excel: "Roll No" (Manual) -> FabricRoll
  rollId             String        @map("roll_id") @db.Uuid
  roll               FabricRoll    @relation(fields: [rollId], references: [id], onDelete: Restrict)
  /// Excel: "Purpose" (Dropdown -> L_Purpose)
  purpose            IssuePurpose
  /// Excel: "Order No" (Dropdown -> Order)
  orderId            String        @map("order_id") @db.Uuid
  order              BuyerOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Excel: "Style No" (Dropdown -> Style Master)
  styleId            String        @map("style_id") @db.Uuid
  style              Style         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  /// Excel: "Name" (Auto) - the person issuing, from Employee Master.
  issuedByEmployeeId String?       @map("issued_by_employee_id") @db.Uuid
  issuedByEmployee   Employee?     @relation(fields: [issuedByEmployeeId], references: [id], onDelete: SetNull)
  /// Name as printed on the slip.
  issuedByName       String        @map("issued_by_name") @db.VarChar(120)
  /// Excel: "Fabric Qty  Issued" (Manual)
  fabricQtyIssued    Decimal       @map("fabric_qty_issued") @db.Decimal(18, 4)
  /// Excel: "Fabric name" (Dropdown) - note on sheet: "eg- 10 oz"
  fabricName         String?       @map("fabric_name") @db.VarChar(120)
  /// Excel: "Color Code" (Dropdown -> L_ColorCode)
  colorCode          String?       @map("color_code") @db.VarChar(60)
  /// UOM of the issued quantity (the sheet works in Mtrs).
  uom                String        @default("Mtrs") @db.VarChar(20)
  /// Excel: "Status" (Auto -> L_StatusGeneral)
  status             StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Text)
  remarks            String?       @db.Text

  /// Where the fabric came out of. The issue, the roll balance and the ledger
  /// entry must all name one location or the stock cannot be found again.
  location String @default("MAIN STORE") @db.VarChar(80)

  /// C5 - THE APPROVED CUTTING CHALLAN LINE THIS ISSUE FULFILS.
  ///
  /// Nullable, and deliberately so: ten fabric issues predate the challan and
  /// cannot be given a requirement that was never raised. `assertChallanLine()`
  /// requires one on every NEW issue, so the column is null only for history.
  /// The partial CHECK `fabric_issues_new_rows_need_challan` enforces the same
  /// rule in PostgreSQL against rows created after the migration.
  cuttingChallanLineId String?             @map("cutting_challan_line_id") @db.Uuid
  cuttingChallanLine   CuttingChallanLine? @relation(fields: [cuttingChallanLineId], references: [id], onDelete: Restrict)

  /// C3 / C6 - where the fabric went TO, when this issue moved it to an
  /// in-process location rather than out of the company's stock entirely.
  ///
  ///     purpose = CUTTING             -> "CUTTING FLOOR"
  ///     purpose = DYEING / PRINTING   -> the job worker's location
  ///
  /// Null on issues raised before C3, which posted a bare OUT and left the
  /// fabric invisible while it was being worked on. Those are readable and
  /// are NOT rewritten; see the migration note.
  inProcessLocation String? @map("in_process_location") @db.VarChar(80)

  /// The stock item behind the roll, resolved in the posting transaction.
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// The moment the issue and its Stock Ledger OUT were committed together.
  /// Non-null is the proof the fabric actually left stock; the two writes
  /// share one transaction, so this is set for both or set for neither.
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(3)
  postedById   String?   @map("posted_by_id") @db.Uuid
  postedByName String?   @map("posted_by_name") @db.VarChar(120)

  /// The job work order (PO) this challan draws on, when purpose is job work.
  /// Several challans may draw on one order; see DyeIssue.issuedQty.
  jobWorkId String?   @map("job_work_id") @db.Uuid
  jobWork   DyeIssue? @relation("JobWorkChallans", fields: [jobWorkId], references: [id], onDelete: Restrict)

  /// The roll's shade and dye lot AS ISSUED - snapshotted, because the shade
  /// check on the next issue against the same challan line is judged against
  /// what was actually cut, not against a roll somebody re-graded afterwards.
  shade          String? @db.VarChar(20)
  dyeLot         String? @map("dye_lot") @db.VarChar(40)
  /// Set only when this issue knowingly put a second shade or lot onto a
  /// cutting challan line. The reason is the override; without it the issue
  /// is refused. Null on every issue that matched.
  shadeMixReason String? @map("shade_mix_reason") @db.Text

  dyeIssues     DyeIssue[]     @relation("JobWorkFirstIssue")
  cuttingIssues CuttingIssue[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
