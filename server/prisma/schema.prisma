// ===========================================================================
//  15. FABRIC SCRUTINY
// ===========================================================================

/// EXCEL SHEET: "Fabric Scrutiny Report"
/// (Role Acess - QC Dept - Decision by Dinesh Sir)
model FabricScrutiny {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `decision` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// System document number (the sheet has none).
  scrutinyNo String @unique @map("scrutiny_no") @db.VarChar(40)

  /// Excel: "Date" (Auto)
  scrutinyDate        DateTime         @map("scrutiny_date") @db.Date
  /// Excel: "Fabric No" (Dropdown -> FabricRoll)
  rollId              String           @map("roll_id") @db.Uuid
  roll                FabricRoll       @relation(fields: [rollId], references: [id], onDelete: Restrict)
  /// Excel: "Order No" (Dropdown -> Order)
  orderId             String           @map("order_id") @db.Uuid
  order               BuyerOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Excel: "Style No" (Dropdown -> Style Master)
  styleId             String           @map("style_id") @db.Uuid
  style               Style            @relation(fields: [styleId], references: [id], onDelete: Restrict)
  /// Excel: "Defect Type" (Dropdown -> L_DefectType); sheet note names the
  /// fabric-side values "Dyeing Defect / Weaving Defect".
  defectType          String           @map("defect_type") @db.VarChar(80)
  /// Excel: "Qty Affected" (Manual)
  qtyAffected         Decimal          @map("qty_affected") @db.Decimal(18, 4)
  /// UOM of qtyAffected (the sheet works in Mtrs for fabric).
  uom                 String           @default("Mtrs") @db.VarChar(20)
  /// Excel: "Checked By" (Dropdown -> Employee Master)
  checkedByEmployeeId String?          @map("checked_by_employee_id") @db.Uuid
  checkedByEmployee   Employee?        @relation(fields: [checkedByEmployeeId], references: [id], onDelete: SetNull)
  checkedByName       String           @map("checked_by_name") @db.VarChar(120)
  /// Excel: "Authorised By" (Dropdown -> L_AuthorisedBy)
  authorisedBy        String?          @map("authorised_by") @db.VarChar(120)
  /// Excel: "Decision" (Dropdown -> Accept / Reject / Rework)
  decision            ScrutinyDecision @default(ACCEPT)
  /// Excel: "Remarks" (Text)
  remarks             String?          @db.Text

  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  /// Name as printed against the decision, stamped rather than typed.
  decidedByName String?   @map("decided_by_name") @db.VarChar(120)

  /// A finalised scrutiny is LOCKED. QC records what it found and the
  /// Director decides; once that decision is taken the record stops moving,
  /// because a roll may already have been rejected or released on the
  /// strength of it. Corrections go through document_amendments, which keeps
  /// the before/after set - not through an edit that erases what was decided.
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedById     String?   @map("locked_by_id") @db.Uuid
  /// How many amendments have been recorded against this scrutiny.
  amendmentCount Int       @default(0) @map("amendment_count")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// C4 - the structured findings behind the decision.
  defects FabricScrutinyDefect[]

  /// C4 - the job-work returns this scrutiny was raised to clear.
  dyeingReceipts DyeingReceipt[]

  @@index([rollId])
  @@index([orderId])
  @@index([styleId])
  @@index([decision])
  @@index([scrutinyDate])
  @@index([isLocked])
  @@index([deletedAt])
  @@map("fabric_scrutinies")
}

/// C4 - ONE DEFECT FOUND, ON ONE ROLL, WITH A QUANTITY.
///
/// The scrutiny header already carried a single `defectType` and a single
/// `qtyAffected`, which is what the workbook prints and is kept. It cannot
/// describe a real Fabric Checking Report: a checker who finds shade variation
/// on two rolls and a broken pick on a third has three findings, not one, and
/// collapsing them into one row loses both the per-roll quantity and the
/// reason a director is being asked to reject.
///
/// The header columns remain the SUMMARY - `qtyAffected` is kept in step with
/// the sum of these lines by the service - and these are the detail.
///
/// A REWORK or REJECT decision cannot be posted without at least one of these.
/// That is enforced in the service AND by the
/// `fabric_scrutinies_decision_needs_defects` trigger, because a rule that
/// exists only in application code is a rule a direct UPDATE walks past.
model FabricScrutinyDefect {
  id         String         @id @default(uuid()) @db.Uuid
  scrutinyId String         @map("scrutiny_id") @db.Uuid
  scrutiny   FabricScrutiny @relation(fields: [scrutinyId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// C4 names two families explicitly - dyeing defects and weaving defects -
  /// and OTHER exists so a real finding is never dropped for want of a box.
  category   DefectCategory
  /// L_DefectType, e.g. "Shade Variation", "Broken Pick". The open list, kept
  /// beside the closed category for the same reason `items.item_category` is
  /// kept beside `items.category`.
  defectType String         @map("defect_type") @db.VarChar(80)

  /// The roll the defect was found on. A scrutiny header names one roll; a
  /// checking report routinely covers a lot, so each line names its own.
  rollId String     @map("roll_id") @db.Uuid
  roll   FabricRoll @relation(fields: [rollId], references: [id], onDelete: Restrict)

  /// How much of that roll is affected, in `uom`.
  qty     Decimal @db.Decimal(18, 4)
  uom     String  @default("Mtrs") @db.VarChar(20)
  remarks String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([scrutinyId, lineNo])
  @@index([scrutinyId])
  @@index([rollId])
  @@index([category])
  @@index([deletedAt])
  @@map("fabric_scrutiny_defects")
}

