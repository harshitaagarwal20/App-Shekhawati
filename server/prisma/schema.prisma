/// EXCEL SHEET: " Plan Approval" / "Cutting Plan Approval" -
/// Cutting / Stitching / Shipping Plan Approval Log
/// (Role Acess - Planning Dept - Approved by Vinay ji (GM) / Dinesh Sir)
model PlanApproval {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `approvalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(PENDING_APPROVAL) @map("workflow_state")

  /// System document number (the sheet has none).
  approvalNo String @unique @map("approval_no") @db.VarChar(40)

  /// Excel: "Date" (Auto) - date the plan was submitted for approval
  submittedDate        DateTime       @map("submitted_date") @db.Date
  /// Excel: "Order No" (Auto -> Order)
  orderId              String         @map("order_id") @db.Uuid
  order                BuyerOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Excel: "Container No" (Auto -> L_ContainerNo)
  containerNo          String?        @map("container_no") @db.VarChar(40)
  /// Excel: "Prepared By" (Auto / Dropdown), e.g. "Vinay ji (GM)"
  preparedBy           String         @map("prepared_by") @db.VarChar(120)
  /// Excel: "Submitted To" (Auto / Dropdown), e.g. "Dinesh Sir"
  submittedTo          String         @map("submitted_to") @db.VarChar(120)
  /// Excel: "Approval Status" (Auto -> Pending / Approved / Rejected)
  approvalStatus       StatusApproval @default(PENDING) @map("approval_status")
  /// Excel: "Rejection Reason" (Text)
  rejectionReason      String?        @map("rejection_reason") @db.Text
  /// Excel: "Rectification Remarks" (Text), e.g. "Revised plan v2"
  rectificationRemarks String?        @map("rectification_remarks") @db.Text
  /// Excel: "Approved Date" (Auto)
  approvedDate         DateTime?      @map("approved_date") @db.Date

  /// The plan being approved. The sheet keys on Order No + Container No only;
  /// the ERP links the actual plan so the approval gates Cutting Issue.
  planningId String?   @map("planning_id") @db.Uuid
  planning   Planning? @relation(fields: [planningId], references: [id], onDelete: SetNull)

  /// Submission round for this order/container (1, 2, ... on resubmission).
  /// This IS the version number: round 2 is version 2 of the plan for that
  /// order and container, raised after round 1 was rejected and rectified.
  ///
  /// C7 keeps this name. `round` and "version" were already the same integer,
  /// and renaming it would have broken every screen and report that prints it
  /// to gain nothing but a synonym. `version` is exposed as an alias on the
  /// API so the vocabulary the brief uses works too.
  round Int @default(1)

  // --- C7: STYLE-WISE VERSIONING, AND ONE CURRENT VERSION ------------------

  /// C7 - the style this plan is for. Plans are style-number-wise AND
  /// container-wise; before C7 the header keyed on order + container only, so
  /// two styles shipping in one container shared a single plan approval and
  /// neither could be superseded without the other.
  ///
  /// Nullable ONLY for the rows that predate C7 - see the migration note.
  /// Every new version states its style.
  styleId String? @map("style_id") @db.Uuid
  style   Style?  @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// C7 - whether this is the version in force for its (style, container).
  ///
  /// Exactly one APPROVED version may be current at a time, and the partial
  /// unique index `plan_approvals_one_current_approved` is what guarantees it
  /// rather than a service remembering to demote the predecessor. Approving
  /// version 2 demotes version 1 in the same transaction; version 1 stays
  /// readable and stays locked.
  isCurrent Boolean @default(false) @map("is_current")

  /// When this version was demoted, and by which successor. A demoted version
  /// is history, not a mistake, and it says so on its own row.
  demotedAt   DateTime? @map("demoted_at") @db.Timestamptz(3)
  demotedById String?   @map("demoted_by_id") @db.Uuid

  /// The version this one was raised to replace. Set when a rejected round is
  /// rectified and resubmitted, so the chain of attempts can be walked in
  /// either direction rather than inferred from a shared order number.
  supersedesId String?        @map("supersedes_id") @db.Uuid
  supersedes   PlanApproval?  @relation("PlanApprovalVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy PlanApproval[] @relation("PlanApprovalVersions")

  /// When the rejected round was rectified and a successor raised.
  rectifiedAt DateTime? @map("rectified_at") @db.Timestamptz(3)
  /// When the decision was taken, whichever way it went. approvedDate is null
  /// on a rejection, so without this a refused round carries no timestamp.
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(3)

  /// An APPROVED version is immutable - a cutting issue may already have been
  /// raised against it. A rejected version is immutable too, once it has been
  /// rectified: the successor is where the work continues. Only a pending
  /// round, and a rejected one not yet rectified, are still open to editing.
  isLocked Boolean   @default(false) @map("is_locked")
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)

  preparedById   String? @map("prepared_by_id") @db.Uuid
  approvedById   String? @map("approved_by_id") @db.Uuid
  approvedByName String? @map("approved_by_name") @db.VarChar(120)

  cuttingIssues   CuttingIssue[]
  /// C5 - cutting challans authorised by this approval version.
  cuttingChallans CuttingChallan[]
  /// C7 - the three plan types this version presents for signature.
  lines           PlanApprovalLine[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([orderId])
  @@index([planningId])
  @@index([approvalStatus])
  @@index([submittedDate])
  @@index([supersedesId])
  @@index([isLocked])
  @@index([styleId])
  @@index([isCurrent])
  @@index([deletedAt])
  @@map("plan_approvals")
}

/// C7 - ONE PLAN TYPE ON ONE PLAN APPROVAL VERSION.
///
/// The production department prepares three plans - cutting, stitching and
/// shipping - and presents them together for one signature. They are three
/// lines of one document, not three documents: approving the cutting plan and
/// leaving the shipping plan unsigned is not a state the office recognises.
///
/// THESE ARE PLANNING RECORDS AND NOTHING ELSE. A STITCHING line is a sheet of
/// paper saying how many pieces are planned to be stitched and by when. There
/// is no stitching execution in this system, no dispatch and no packing, and
/// `prisma/verify-scope.js` carries an explicit allowlist entry saying so.
model PlanApprovalLine {
  id             String       @id @default(uuid()) @db.Uuid
  planApprovalId String       @map("plan_approval_id") @db.Uuid
  planApproval   PlanApproval @relation(fields: [planApprovalId], references: [id], onDelete: Cascade)

  /// CUTTING / STITCHING / SHIPPING.
  planType PlanType @map("plan_type")

  /// What the plan commits to, and when.
  plannedQty   Decimal   @map("planned_qty") @db.Decimal(18, 4)
  uom          String    @default("Pcs") @db.VarChar(20)
  plannedStart DateTime? @map("planned_start") @db.Date
  plannedEnd   DateTime? @map("planned_end") @db.Date
  /// Free-text unit / firm the plan names, as the sheet prints it.
  plannedUnit  String?   @map("planned_unit") @db.VarChar(120)
  remarks      String?   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// One line per plan type per version. Two cutting plans on one signature
  /// is not a richer plan, it is an unresolved disagreement.
  @@unique([planApprovalId, planType])
  @@index([planApprovalId])
  @@index([planType])
  @@index([deletedAt])
  @@map("plan_approval_lines")
}

// ===========================================================================
//  16a. MATERIAL PLAN   (C12)
// ===========================================================================

/// C12 - THE RAW MATERIAL PLAN. WHAT HAS TO BE BOUGHT IN, AND WHO SIGNED IT.
///
/// The office plans accessories and fabric the same way it plans cutting,
/// stitching and shipping: somebody works out what the order consumes, and
/// somebody senior signs it before procurement goes to the market. Until now
/// only the arithmetic existed. `calculateRequirement()` has always exploded
/// the Style BOM into a per-item requirement, and the Buyer Order screen has
/// always shown it - but it was a DERIVED PANEL, recomputed on every read.
/// Nobody prepared it, nobody signed it, and there was no version of it to
/// point back to when the BOM later moved.
///
/// This is that panel turned into a document.
///
/// WHY THE LINES ARE COPIED RATHER THAN COMPUTED
///
/// A plan that recalculates itself is not a plan, it is a report. The Style
/// BOM is edited - a wastage percentage is renegotiated, an accessory is
/// substituted, `avgUtilisationPerPiece` is corrected - and an approved
/// document must not silently change underneath the signature it carries.
/// Every line therefore stores the figures AS THEY STOOD when the plan was
/// raised, together with `requirementBasis` spelling out the multiplication.
/// The same reasoning already freezes `purchase_orders.computed_requirement_qty`
/// and `cutting_challan_lines.computed_requirement_qty`.
///
/// The arithmetic itself is NOT duplicated here. The service calls
/// `calculateRequirement()` - the one requirement calculation in this
/// application - and stores what it returns. A second implementation would be
/// a second answer, and two answers to "how much do we need" is the problem
/// this document exists to end.
///
/// [A] ONLY - IT AUTHORISES, IT DOES NOT BUY
///
/// Approving a material plan is a signature on a shopping list. It moves no
/// stock, raises no purchase order and reserves nothing. Procurement continues
/// to be bounded by the style requirement ceiling it has always been bounded
/// by; the plan does not gate a PO. It is the office's record that the
/// requirement was reviewed and agreed before anybody went to a vendor.
model MaterialPlan {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `approvalStatus` below is kept in step with it by
  /// approvalEngine.js on every transition. Nothing writes one without the
  /// other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Auto document number - MP-0001.
  planNo   String   @unique @map("plan_no") @db.VarChar(40)
  planDate DateTime @map("plan_date") @db.Date

  /// The order and style the requirement is for. Style is carried explicitly
  /// rather than read through the order: the plan is a statement about a
  /// style's consumption, and an order whose style is later corrected must not
  /// retrospectively change what a signed plan was about.
  orderId String     @map("order_id") @db.Uuid
  order   BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  styleId String     @map("style_id") @db.Uuid
  style   Style      @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// C13 - THE ORDER LINE THIS PLAN IS FOR.
  ///
  /// An order holds several styles, each with its own quantity, so "the
  /// material plan for this order" is not a single document - it is one plan
  /// per line. The line is what supplies the pieces the requirement is
  /// multiplied by; `styleId` above is kept alongside it for indexing and for
  /// screens that show the style without loading the line.
  ///
  /// Nullable ONLY for plans raised before C13, which predate the line table.
  orderLineId String?         @map("order_line_id") @db.Uuid
  orderLine   BuyerOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  /// Excel: "Container No" (Manual / Dropdown -> L_ContainerNo), as the other
  /// planning documents carry it.
  containerNo String? @map("container_no") @db.VarChar(40)

  /// THE TWO QUANTITIES THE PLAN WAS WORKED OUT AGAINST, frozen at creation.
  ///
  /// `effectiveQty` is the order quantity plus the excess the Director actually
  /// APPROVED - never the requested one. Storing both is what lets a reader a
  /// month later see that a plan for 10,100 pieces was 10,000 ordered plus a
  /// signed 1%, rather than wonder where the figure came from.
  orderQty     Decimal @map("order_qty") @db.Decimal(18, 4)
  effectiveQty Decimal @map("effective_qty") @db.Decimal(18, 4)

  /// Plan revision. A rejected plan is rectified into a successor version
  /// rather than edited in place, exactly as Planning and Plan Approval do.
  version Int @default(1)

  /// Approval state, kept in step with `workflowState` by the engine.
  approvalStatus StatusApproval @default(PENDING) @map("approval_status")

  /// Excel: "Submitted To" (-> L_AuthorisedBy). Null while this is a draft.
  submittedTo     String?   @map("submitted_to") @db.VarChar(120)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedById   String?   @map("submitted_by_id") @db.Uuid
  /// Excel: "Prepared By", e.g. "Vinay ji (GM)". Stamped from the account that
  /// submitted, never typed.
  submittedByName String?   @map("submitted_by_name") @db.VarChar(120)

  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Required whenever approvalStatus is REJECTED.
  rejectionReason String?   @map("rejection_reason") @db.Text

  remarks String? @db.Text

  lines MaterialPlanLine[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// C13 - one live version per ORDER LINE per revision. Keyed on the line
  /// rather than on the style, because one order may legitimately carry the
  /// same style twice in different colours, and each of those is its own
  /// requirement. Two version-1 plans for one line is not a richer plan, it is
  /// an unresolved disagreement.
  @@unique([orderLineId, version])
  @@index([orderId])
  @@index([styleId])
  @@index([orderLineId])
  @@index([planDate])
  @@index([approvalStatus])
  @@index([workflowState])
  @@index([containerNo])
  @@index([deletedAt])
  @@map("material_plans")
}

/// One material the order needs bought in, and the arithmetic that says so.
///
/// FABRIC AND ACCESSORIES SIT IN THE SAME TABLE because they are the same
/// question - what does one piece consume, times how many pieces, plus
/// wastage. `category` separates them where a rule has to (accessories are
/// held to a tighter excess than fabric); nothing else needs to care.
///
/// EVERY FIGURE HERE IS A COPY. `avgUtilisationPerPiece` and `wastagePct` are
/// what the BOM said at creation, not what it says now, and `requirementBasis`
/// is the multiplication written out in words so that a figure on a signed
/// plan can always be re-checked by hand.
model MaterialPlanLine {
  id     String       @id @default(uuid()) @db.Uuid
  planId String       @map("plan_id") @db.Uuid
  plan   MaterialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// L_ItemCategory as the rest of the pipeline writes it - Fabric,
  /// Accessories, Handle, Zipper, Label, Thread, Button, Packaging Material.
  itemCategory    String       @map("item_category") @db.VarChar(60)
  /// C2 - the commercial category, resolved once and stored, so a tolerance
  /// rule never has to re-derive it from the open dropdown value above.
  category        ItemCategory
  subCategory     String?      @map("sub_category") @db.VarChar(60)
  accessoriesItem String?      @map("accessories_item") @db.VarChar(80)
  /// L_AccessoryVariety, copied from the BOM line with everything else.
  accessoryType   String?      @map("accessory_type") @db.VarChar(120)
  colorCode       String?      @map("color_code") @db.VarChar(60)
  content         String?      @db.VarChar(80)
  gsm             String?      @db.VarChar(20)
  count           String?      @db.VarChar(20)
  /// Free description as it should print on the purchase order.
  description     String?      @db.VarChar(200)
  hsnCode         String?      @map("hsn_code") @db.VarChar(20)
  uom             String       @db.VarChar(20)

  /// FROZEN FROM THE BOM. What one finished piece consumes, and the wastage
  /// allowance agreed for this material.
  avgUtilisationPerPiece Decimal @map("avg_utilisation_per_piece") @db.Decimal(18, 4)
  wastagePct             Decimal @default(0) @map("wastage_pct") @db.Decimal(18, 6)

  /// perPiece x orderQty. The requirement before any allowance - shown beside
  /// `requiredQty` so a reader can see what the allowances added.
  baseRequirement Decimal @map("base_requirement") @db.Decimal(18, 4)

  /// WHAT PROCUREMENT IS BEING ASKED TO BUY.
  /// perPiece x effectiveQty x (1 + wastagePct).
  requiredQty Decimal @map("required_qty") @db.Decimal(18, 4)

  /// How that figure was arrived at, in words, from the shared calculation.
  requirementBasis String? @map("requirement_basis") @db.Text

  /// Which Style BOM line this came from, where it came from one. Null for
  /// fabric taken from the Style header average, which is the authority for
  /// fabric - see domain/requirement.js.
  bomLineNo Int? @map("bom_line_no")

  remarks String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([planId, lineNo])
  @@index([planId])
  @@index([category])
  @@index([deletedAt])
  @@map("material_plan_lines")
}

// ===========================================================================
//  16b. CUTTING CHALLAN   (C5)
// ===========================================================================

/// C5 - THE REQUIREMENT THE CUTTING DEPARTMENT RAISES BEFORE ANY FABRIC MOVES.
///
/// Until this document existed the cutting floor could pull fabric out of the
/// store on a Fabric Issue alone - a store keeper and a supervisor, no
/// approved statement of what was needed, and nothing to reconcile the issues
/// against afterwards. The challan is that statement: an [A] document raised
/// against an APPROVED planning version, listing what is required and how
/// much, and every Fabric Issue must now quote one of its lines.
///
/// Approval-enabled but NOT stock-moving. A challan is a request; the fabric
/// moves on the Fabric Issue that fulfils it.
model CuttingChallan {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `status` below is kept in step with it by
  /// approvalEngine.js on every transition. Nothing writes one without the
  /// other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Auto document number - CC-0001.
  challanNo   String   @unique @map("challan_no") @db.VarChar(40)
  challanDate DateTime @map("challan_date") @db.Date

  /// The order and style the requirement is for.
  orderId String     @map("order_id") @db.Uuid
  order   BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  styleId String     @map("style_id") @db.Uuid
  style   Style      @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// THE APPROVED PLANNING VERSION THIS CHALLAN IS RAISED AGAINST.
  ///
  /// Required, and required to be approved: the whole point of the document is
  /// that cutting draws against an authorised plan rather than against a
  /// telephone call. `assertPlanApproved()` checks the state; the foreign key
  /// only guarantees the plan exists.
  planningId     String        @map("planning_id") @db.Uuid
  planning       Planning      @relation(fields: [planningId], references: [id], onDelete: Restrict)
  /// The Plan Approval version that authorised that plan, where the office
  /// works through one. Null where the plan itself carries the approval.
  planApprovalId String?       @map("plan_approval_id") @db.Uuid
  planApproval   PlanApproval? @relation(fields: [planApprovalId], references: [id], onDelete: SetNull)

  containerNo String?   @map("container_no") @db.VarChar(40)
  requiredBy  DateTime? @map("required_by") @db.Date

  /// Fulfilment status of the challan as a whole, derived from its lines by
  /// `recomputeFulfilment()` and never typed.
  status StatusGeneral @default(PENDING)

  /// C5 - a challan may be CLOSED SHORT: the cutting floor decides it needs no
  /// more, and the outstanding quantity is deliberately abandoned rather than
  /// left open forever. Distinct from COMPLETED, which means it was filled.
  closedShortAt     DateTime? @map("closed_short_at") @db.Timestamptz(3)
  closedShortById   String?   @map("closed_short_by_id") @db.Uuid
  closedShortByName String?   @map("closed_short_by_name") @db.VarChar(120)
  closedShortReason String?   @map("closed_short_reason") @db.Text

  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason") @db.Text

  remarks String? @db.Text

  lines CuttingChallanLine[]

  /// Cut pieces the cutting department has handed over against this challan.
  cutPiecesReceipts CutPiecesReceipt[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([orderId])
  @@index([styleId])
  @@index([planningId])
  @@index([planApprovalId])
  @@index([challanDate])
  @@index([status])
  @@index([workflowState])
  @@index([containerNo])
  @@index([deletedAt])
  @@map("cutting_challans")
}

/// One required item on a cutting challan, and how much of it has been issued.
///
/// `issuedQty` is a DERIVED RUNNING TOTAL, recomputed from the fabric issues
/// that quote this line inside the same transaction that posts them. It is
/// never incremented from a number a caller supplied, for exactly the reason
/// `stock_balances` is never incremented in place: a total that is added to
/// can drift, and a total that is re-derived cannot.
///
/// OVER-FULFILMENT IS IMPOSSIBLE, not merely refused: the service checks it
/// and `cutting_challan_lines_no_over_fulfilment` enforces it in PostgreSQL.
model CuttingChallanLine {
  id        String         @id @default(uuid()) @db.Uuid
  challanId String         @map("challan_id") @db.Uuid
  challan   CuttingChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  /// L_ItemCategory, as the rest of the pipeline writes it.
  itemCategory    String       @map("item_category") @db.VarChar(60)
  /// C2 - the commercial category, resolved and stored.
  category        ItemCategory
  subCategory     String?      @map("sub_category") @db.VarChar(60)
  accessoriesItem String?      @map("accessories_item") @db.VarChar(80)
  colorCode       String?      @map("color_code") @db.VarChar(60)
  description     String?      @db.VarChar(200)

  /// What the cutting floor says it needs.
  requiredQty Decimal @map("required_qty") @db.Decimal(18, 4)
  uom         String  @db.VarChar(20)

  /// C9 - the shared requirement calculation's answer for this line at the
  /// moment the challan was raised, and how it was arrived at. Frozen for the
  /// same reason `purchase_orders.computed_requirement_qty` is frozen: the BOM
  /// may move, and a figure somebody has signed may not.
  computedRequirementQty Decimal? @map("computed_requirement_qty") @db.Decimal(18, 4)
  requirementBasis       String?  @map("requirement_basis") @db.Text

  /// Derived. SUM of the posted fabric issues quoting this line.
  issuedQty Decimal @default(0) @map("issued_qty") @db.Decimal(18, 4)

  /// PENDING / IN_PROGRESS / COMPLETED / CANCELLED, derived from the two
  /// quantities above and from an explicit short close.
  status StatusGeneral @default(PENDING)

  remarks String? @db.Text

  fabricIssues FabricIssue[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([challanId, lineNo])
  @@index([challanId])
  @@index([status])
  @@index([category])
  @@index([deletedAt])
  @@map("cutting_challan_lines")
}

// ===========================================================================
//  CUT PIECES RECEIPT
//
//  What the cutting department hands over once the fabric has been cut: good
//  pieces, rejected pieces and handles, counted and signed for at the cutting
//  floor. It sits between the Cutting Challan (what cutting asked for) and the
//  Cutting Issue (what goes out to the stitching unit), so the store can see
//  how many cut pieces it holds for an order before it issues any.
//
//  It records a count; it does not move fabric stock. Fabric leaves the ledger
//  on the Cutting Issue, which is where the fabric equation is checked.
// ===========================================================================
model CutPiecesReceipt {
  id String @id @default(uuid()) @db.Uuid

  /// CPR-0001, from document_sequences.
  receiptNo   String   @unique @map("receipt_no") @db.VarChar(40)
  receiptDate DateTime @map("receipt_date") @db.Date

  orderId String     @map("order_id") @db.Uuid
  order   BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  styleId String     @map("style_id") @db.Uuid
  style   Style      @relation(fields: [styleId], references: [id], onDelete: Restrict)

  /// The requirement the pieces were cut against. Optional: a lot cut before
  /// challans were in use still has to be counted in.
  cuttingChallanId String?         @map("cutting_challan_id") @db.Uuid
  cuttingChallan   CuttingChallan? @relation(fields: [cuttingChallanId], references: [id], onDelete: SetNull)

  /// Who handed the pieces over - the cutting master. Picked from Employees
  /// when they are on the master, typed otherwise; the name is always kept.
  cuttingMasterId   String?   @map("cutting_master_id") @db.Uuid
  cuttingMaster     Employee? @relation(fields: [cuttingMasterId], references: [id], onDelete: SetNull)
  cuttingMasterName String    @map("cutting_master_name") @db.VarChar(120)

  colorCode String? @map("color_code") @db.VarChar(60)
  lotNo     String? @map("lot_no") @db.VarChar(40)

  /// Good pieces, fit to go to stitching.
  pcsReceived     Decimal @map("pcs_received") @db.Decimal(18, 4)
  /// Pieces cut badly or damaged, counted but not usable.
  pcsRejected     Decimal @default(0) @map("pcs_rejected") @db.Decimal(18, 4)
  /// DERIVED from the style's panel list when it has one:
  /// pcsReceived x handles per bag. Typed only for a style with no panel list.
  handlesReceived Decimal @default(0) @map("handles_received") @db.Decimal(18, 4)

  /// The style's panel list as it stood when these pieces were counted in -
  /// panels per bag (every component) and handles per bag (HANDLE components).
  /// Frozen so a later correction to the style does not rewrite this receipt.
  /// Null on a style with no panel list, where the counts were typed.
  panelsPerBag   Int?     @map("panels_per_bag")
  handlesPerBag  Int?     @map("handles_per_bag")
  /// pcsReceived x panelsPerBag - every cut panel handed over. Derived.
  panelsReceived Decimal? @map("panels_received") @db.Decimal(18, 4)
  /// The per-component breakdown behind panelsReceived, as it was multiplied:
  /// [{ name, componentType, piecesPerBag, pieces }].
  panelBreakdown Json?    @map("panel_breakdown") @db.JsonB

  /// The logged-in user who counted the pieces in.
  receivedByName String? @map("received_by_name") @db.VarChar(120)

  remarks String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([orderId])
  @@index([styleId])
  @@index([cuttingChallanId])
  @@index([cuttingMasterId])
  @@index([receiptDate])
  @@index([deletedAt])
  @@map("cut_pieces_receipts")
}

// ===========================================================================
//  17. CUTTING ISSUE   *** FINAL STAGE OF THE APPLICATION ***
// ===========================================================================

/// EXCEL SHEET: "Cutting Issue" - Cutting Format
/// (Role Acess - Cutting Dept (Tailor/Supervisor))
/// Container No in the sheet is a formula pulling the container from Planning
/// via Order No; here it is carried on the record and defaulted from the plan.
///
/// This is the last document the application produces. Nothing downstream of
/// it (stitching, QC, packing, dispatch) exists in this system.
model CuttingIssue {
  id String @id @default(uuid()) @db.Uuid

  /// The explicit workflow position, shared by every approvable document in
  /// this system. See the DocumentState enum for the transition diagram.
  ///
  /// This is the AUTHORITY. `status` below is kept in step with it by
  /// approvalEngine.js on every transition, because that column is what the
  /// workbook prints and what the table CHECK constraints already refer to.
  /// Nothing writes one without the other.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Excel: "Challan No" (Manual) - CH-001
  challanNo String @unique @map("challan_no") @db.VarChar(40)

  /// Excel: "Date" (Auto)
  issueDate                    DateTime   @map("issue_date") @db.Date
  /// Excel: "Order No" (Auto -> Order)
  orderId                      String     @map("order_id") @db.Uuid
  order                        BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Excel: "Style No" (Auto -> Style Master)
  styleId                      String     @map("style_id") @db.Uuid
  style                        Style      @relation(fields: [styleId], references: [id], onDelete: Restrict)
  /// Excel: "Planned Cutting" (Auto, from the approved plan / order qty)
  plannedCutting               Decimal    @map("planned_cutting") @db.Decimal(18, 4)
  /// Excel: "Firm Name" (Auto -> L_StitchingUnit) - the receiving unit
  firmName                     String     @map("firm_name") @db.VarChar(120)
  /// Excel: "Unit wise Cutting Pcs to be issued" (Auto, from the plan)
  unitWiseCuttingPcsToBeIssued Decimal    @map("unit_wise_cutting_pcs_to_be_issued") @db.Decimal(18, 4)
  /// Excel: "Cutting Pcs Issued" (Manual)
  /// Good cut pieces handed to the stitching unit on this challan.
  cuttingPcsIssued             Decimal    @map("cutting_pcs_issued") @db.Decimal(18, 4)
  /// Cut pieces damaged or rejected during cutting, not handed to stitching.
  cuttingPcsDamaged            Decimal    @default(0) @map("cutting_pcs_damaged") @db.Decimal(18, 4)
  /// Excel: "Handle issued" (Manual)
  handleIssued                 Decimal    @default(0) @map("handle_issued") @db.Decimal(18, 4)

  // --- C6: THE FABRIC EQUATION, AND THE REMAINDER THAT ROLLS BACK ----------
  //
  //  A cutting issue now moves stock. The fabric came to the cutting floor on
  //  a Fabric Issue; what leaves the floor is what was cut into panels, what
  //  is thrown away, and what goes back on the rack. Those three have to add
  //  up to what arrived, or something has gone missing and nobody noticed:
  //
  //      issuedQty = consumedQty + remainderQty + wastageQty + fabricDamageQty
  //
  //  WASTAGE IS ENTERED, NOT INFERRED. Deriving it as "whatever is left over"
  //  would make the equation balance by construction and check nothing at all
  //  - the arithmetic would absorb a mis-count silently. The supervisor states
  //  it, and REMAINDER_RECONCILES refuses the posting if the four numbers do
  //  not agree.

  /// Fabric that arrived on the cutting floor for this challan, in `fabricUom`.
  issuedQty       Decimal @default(0) @map("issued_qty") @db.Decimal(18, 4)
  /// Cut into panels. Leaves stock for good.
  consumedQty     Decimal @default(0) @map("consumed_qty") @db.Decimal(18, 4)
  /// Went back on the rack, on the SAME roll it came off. Re-enters stock.
  remainderQty    Decimal @default(0) @map("remainder_qty") @db.Decimal(18, 4)
  /// Thrown away. Explicitly stated by the supervisor; never derived.
  wastageQty      Decimal @default(0) @map("wastage_qty") @db.Decimal(18, 4)
  /// Fabric damaged during cutting and recorded separately from normal wastage.
  fabricDamageQty Decimal @default(0) @map("fabric_damage_qty") @db.Decimal(18, 4)
  /// END-BITS. Usable offcuts too short to go back as a roll but long enough
  /// to cut a pocket, a handle or a sample from. Re-enter stock at the
  /// REMNANT STORE rather than being thrown away with the wastage, so they
  /// can be issued again and are valued as stock rather than written off.
  remnantQty      Decimal @default(0) @map("remnant_qty") @db.Decimal(18, 4)
  /// UOM the quantities above are measured in (the sheet works in Mtrs).
  fabricUom       String  @default("Mtrs") @map("fabric_uom") @db.VarChar(20)

  // --- PLANNED VS ACTUAL CONSUMPTION, FROZEN AT POSTING ----------------------
  //
  //  What the style SAYS one bag takes, times the bags actually cut, against
  //  what the floor actually used. Written by post() and never typed, so the
  //  cutting-efficiency report reads what was true on the day rather than
  //  re-deriving it from a style whose average has since been renegotiated.

  /// The style's average fabric per piece at posting.
  stdConsumptionPerPc   Decimal? @map("std_consumption_per_pc") @db.Decimal(12, 4)
  /// (good pieces + damaged pieces) x stdConsumptionPerPc - what the cut
  /// SHOULD have used. Damaged pieces count because the cloth was cut for
  /// them all the same.
  plannedConsumptionQty Decimal? @map("planned_consumption_qty") @db.Decimal(18, 4)
  /// What the cut ACTUALLY used: consumed + wastage + fabric damage. Neither
  /// the remainder nor the remnants, which went back into stock.
  actualConsumptionQty  Decimal? @map("actual_consumption_qty") @db.Decimal(18, 4)
  /// planned / actual, as a fraction. 1.0 = exactly to standard; below 1 the
  /// floor used more cloth than the style allows.
  cuttingEfficiency     Decimal? @map("cutting_efficiency") @db.Decimal(9, 6)

  // --- PANELS, FROM THE STYLE ------------------------------------------------
  /// Frozen from the style's panel list at the time of writing; see
  /// CutPiecesReceipt for the reasoning. Null when the style has none.
  panelsPerBag   Int?     @map("panels_per_bag")
  handlesPerBag  Int?     @map("handles_per_bag")
  /// cuttingPcsIssued x panelsPerBag. Derived.
  panelsIssued   Decimal? @map("panels_issued") @db.Decimal(18, 4)
  panelBreakdown Json?    @map("panel_breakdown") @db.JsonB

  /// C6 - the moment the challan, its OUT for consumption and wastage and its
  /// IN for the remainder were committed together. Non-null is the proof the
  /// ledger moved; `postedAt` alone only proves the paperwork was stamped.
  stockPostedAt DateTime? @map("stock_posted_at") @db.Timestamptz(3)

  /// The stock item the fabric belongs to, resolved in the posting
  /// transaction from the roll behind the fabric issue.
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// The in-process location the fabric was drawn out of. Held on the row so
  /// a posted challan keeps naming the location it actually emptied.
  cuttingLocation String        @default("CUTTING FLOOR") @map("cutting_location") @db.VarChar(80)
  /// Excel: "Container No" (Formula -> Planning, matched on Order No)
  containerNo     String?       @map("container_no") @db.VarChar(40)
  /// Excel: "Status" (Dropdown -> L_StatusGeneral)
  status          StatusGeneral @default(PENDING)
  /// Excel: "Remarks" (Text), e.g. "Lot 1"
  remarks         String?       @db.Text

  /// The plan and the plan approval that authorise this cutting issue.
  planningId     String?       @map("planning_id") @db.Uuid
  planning       Planning?     @relation(fields: [planningId], references: [id], onDelete: SetNull)
  planApprovalId String?       @map("plan_approval_id") @db.Uuid
  planApproval   PlanApproval? @relation(fields: [planApprovalId], references: [id], onDelete: SetNull)
  /// The fabric issue whose roll was cut for this challan.
  fabricIssueId  String?       @map("fabric_issue_id") @db.Uuid
  fabricIssue    FabricIssue?  @relation(fields: [fabricIssueId], references: [id], onDelete: SetNull)

  /// The authorisation, where this challan cuts more than the plan permits.
  /// Null is the normal case: the challan is within the permitted quantity.
  excessApprovalId String?         @map("excess_approval_id") @db.Uuid
  excessApproval   ExcessApproval? @relation(fields: [excessApprovalId], references: [id], onDelete: SetNull)

  /// THE LAST DOCUMENT IN THE PIPELINE, AND AN IMMUTABLE ONE.
  ///
  /// Cloth has been cut. There is no downstream module in this system that
  /// could correct it, and nothing outside the system can un-cut it either.
  /// Once posted the challan is a permanent record: the store, the stitching
  /// unit and the plan all reconcile against it.
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(3)
  postedById   String?   @map("posted_by_id") @db.Uuid
  postedByName String?   @map("posted_by_name") @db.VarChar(120)
  isLocked     Boolean   @default(false) @map("is_locked")
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(3)

  gatePasses GatePass[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([orderId])
  @@index([styleId])
  @@index([planningId])
  @@index([planApprovalId])
  @@index([issueDate])
  @@index([status])
  @@index([containerNo])
  @@index([excessApprovalId])
  @@index([isLocked])
  @@index([inventoryItemId])
  @@index([deletedAt])
  @@map("cutting_issues")
}

// ===========================================================================
//  NOTIFICATIONS  (session: gap-work / Odoo-Zoho comparison)
// ===========================================================================

/// One thing one person should know about - "PO RF-012 is waiting for your
/// approval", "your quotation QT-044 was rejected".
///
/// IN-APP IS THE RECORD; email and WhatsApp are deliveries OF it. Each row
/// carries its own delivery state per channel, so a dispatcher that dies half
/// way resumes from the table (an outbox) rather than from memory, and a
/// message is never sent twice for one row.
///
/// Written by services/notification.service.js only. Approval events arrive
/// through a Prisma extension on approval_history (config/prisma.js), AFTER
/// the transaction that wrote them has committed - a notification about an
/// approval that rolled back would be a lie.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// APPROVAL_REQUESTED, APPROVED, REJECTED, CANCELLED, TNA_OVERDUE ... -
  /// free text so a new kind needs no migration.
  kind  String  @db.VarChar(40)
  title String  @db.VarChar(200)
  body  String? @db.Text
  /// The in-app route to open, e.g. "/purchase-orders/<id>".
  link  String? @db.VarChar(300)

  documentType String? @map("document_type") @db.VarChar(40)
  documentId   String? @map("document_id") @db.Uuid
  documentNo   String? @map("document_no") @db.VarChar(60)

  /// Makes a notification idempotent per person: a daily job that runs twice
  /// writes one row, not two. Null means "never deduplicate".
  dedupeKey String? @map("dedupe_key") @db.VarChar(200)

  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  /// PENDING -> SENT | FAILED, or SKIPPED when the channel is not configured
  /// or the person has not asked for it.
  emailStatus       String    @default("SKIPPED") @map("email_status") @db.VarChar(12)
  whatsappStatus    String    @default("SKIPPED") @map("whatsapp_status") @db.VarChar(12)
  deliveryAttempts  Int       @default(0) @map("delivery_attempts")
  lastDeliveryError String?   @map("last_delivery_error") @db.Text
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([emailStatus])
  @@index([whatsappStatus])
  @@index([documentType, documentId])
  @@map("notifications")
}

// ===========================================================================
//  STYLE COSTING  (session: gap-work / Odoo-Zoho comparison)
// ===========================================================================

/// The FOB cost sheet of a style - what one bag costs to make, and the price
/// that has to be quoted to earn the intended margin.
///
///   material    = SUM(line.consumption x (1 + wastage) x rate)      per piece
///   conversion  = cmt + print + dye/wash + other                      per piece
///   base        = material + conversion
///   overhead    = base x overheadPct
///   rejection   = (base + overhead) x rejectionPct
///   totalCost   = base + overhead + rejection
///   fobInr      = totalCost / (1 - marginPct - commissionPct)
///   fobPrice    = fobInr / exchangeRate      (in the quoting currency)
///
/// Margin and commission are fractions of the SELLING price, which is how an
/// export house states them: "12% margin" means 12% of FOB, not 12% on cost.
/// Every derived figure is computed in domain/costing.js and stored, so a
/// report reads what was signed rather than re-deriving it from rates that
/// have since moved.
///
/// VERSIONED. A sheet is DRAFT while being worked, PENDING_APPROVAL once
/// submitted, and APPROVED when the Director signs it - after which it never
/// changes. A new costing is a new version, copied from the last.
model StyleCostSheet {
  id String @id @default(uuid()) @db.Uuid

  /// CS-0001, from document_sequences.
  costSheetNo String @unique @map("cost_sheet_no") @db.VarChar(40)

  styleId String @map("style_id") @db.Uuid
  style   Style  @relation(fields: [styleId], references: [id], onDelete: Restrict)
  version Int

  /// Optional - a costing done for one particular order rather than for the
  /// style in general.
  orderId String?     @map("order_id") @db.Uuid
  order   BuyerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  costDate DateTime @map("cost_date") @db.Date
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | SUPERSEDED
  status   String   @default("DRAFT") @db.VarChar(20)

  /// The currency the FOB is quoted in, and rupees per unit of it.
  currency     String   @default("USD") @db.VarChar(10)
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  /// The buyer's target price, when they gave one - in `currency`.
  targetPrice  Decimal? @map("target_price") @db.Decimal(18, 4)

  /// Conversion costs per piece, in rupees. Typed.
  cmtCost        Decimal @default(0) @map("cmt_cost") @db.Decimal(18, 4)
  printCost      Decimal @default(0) @map("print_cost") @db.Decimal(18, 4)
  dyeWashCost    Decimal @default(0) @map("dye_wash_cost") @db.Decimal(18, 4)
  otherCost      Decimal @default(0) @map("other_cost") @db.Decimal(18, 4)
  otherCostLabel String? @map("other_cost_label") @db.VarChar(120)

  /// Fractions (0.08 = 8%). Typed.
  overheadPct   Decimal @default(0) @map("overhead_pct") @db.Decimal(9, 6)
  rejectionPct  Decimal @default(0) @map("rejection_pct") @db.Decimal(9, 6)
  commissionPct Decimal @default(0) @map("commission_pct") @db.Decimal(9, 6)
  marginPct     Decimal @default(0) @map("margin_pct") @db.Decimal(9, 6)

  // --- SERVER-CALCULATED, per piece, rupees unless stated ------------------
  materialCost     Decimal? @map("material_cost") @db.Decimal(18, 4)
  conversionCost   Decimal  @default(0) @map("conversion_cost") @db.Decimal(18, 4)
  overheadAmount   Decimal? @map("overhead_amount") @db.Decimal(18, 4)
  rejectionAmount  Decimal? @map("rejection_amount") @db.Decimal(18, 4)
  totalCost        Decimal? @map("total_cost") @db.Decimal(18, 4)
  commissionAmount Decimal? @map("commission_amount") @db.Decimal(18, 4)
  marginAmount     Decimal? @map("margin_amount") @db.Decimal(18, 4)
  fobInr           Decimal? @map("fob_inr") @db.Decimal(18, 4)
  /// In `currency`. Null while any material line is unpriced.
  fobPrice         Decimal? @map("fob_price") @db.Decimal(18, 4)
  /// The margin actually earned if the buyer pays `targetPrice`, as a fraction.
  marginAtTarget   Decimal? @map("margin_at_target") @db.Decimal(9, 6)

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  rejectionReason String?   @map("rejection_reason") @db.Text
  remarks         String?   @db.Text

  lines StyleCostSheetLine[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([styleId, version])
  @@index([styleId])
  @@index([orderId])
  @@index([status])
  @@index([deletedAt])
  @@map("style_cost_sheets")
}

/// One material on a cost sheet - copied from the BOM when the sheet is made,
/// so a later BOM edit does not move a figure somebody has signed. Lines may
/// also be added by hand for things the BOM does not carry.
model StyleCostSheetLine {
  id          String         @id @default(uuid()) @db.Uuid
  costSheetId String         @map("cost_sheet_id") @db.Uuid
  costSheet   StyleCostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  lineNo      Int            @map("line_no")

  /// The BOM line this was copied from; null for a line added by hand.
  bomLineNo       Int?    @map("bom_line_no")
  itemCategory    String  @map("item_category") @db.VarChar(60)
  subCategory     String? @map("sub_category") @db.VarChar(60)
  accessoriesItem String? @map("accessories_item") @db.VarChar(80)
  /// L_AccessoryVariety - which kind of that accessory ("4-hole horn 18L").
  accessoryType   String? @map("accessory_type") @db.VarChar(120)
  colorCode       String? @map("color_code") @db.VarChar(60)
  description     String? @db.VarChar(200)
  uom             String  @db.VarChar(20)

  /// Per piece, before wastage. Typed or copied from the BOM.
  consumption      Decimal  @db.Decimal(12, 4)
  wastagePct       Decimal  @default(0) @map("wastage_pct") @db.Decimal(9, 6)
  /// SERVER-CALCULATED. consumption x (1 + wastagePct).
  grossConsumption Decimal  @map("gross_consumption") @db.Decimal(14, 6)
  /// Rupees per UOM. Null until somebody prices it.
  rate             Decimal? @db.Decimal(18, 4)
  /// Where the suggested rate came from - "PO RF-012/1, 12-09-2026" - or
  /// "manual". A rate is only as good as its source.
  rateSource       String?  @map("rate_source") @db.VarChar(200)
  /// SERVER-CALCULATED. grossConsumption x rate. Null while unpriced.
  amount           Decimal? @db.Decimal(18, 4)

  @@unique([costSheetId, lineNo])
  @@index([costSheetId])
  @@map("style_cost_sheet_lines")
}

// ===========================================================================
//  app-si-eb: FIFO COST LAYERS
// ===========================================================================

/// ONE RECEIPT'S WORTH OF STOCK AT ITS OWN COST - THE FIFO LAYER.
///
/// ---------------------------------------------------------------------------
///  THE POLICY (docs/STOCK-VALUATION-POLICY.md)
///
///  Stock is valued FIRST IN, FIRST OUT. Every IN movement opens a layer at
///  its own rate; every OUT consumes the OLDEST layers at that (item,
///  location) first, and the ledger row records the cost of exactly the
///  layers it consumed. A transfer (store -> cutting floor, store -> dye house)
///  carries its consumed layers across unchanged, KEEPING THEIR ORIGINAL
///  `layerDate`, so moving cloth between locations never makes it younger or
///  changes its cost.
///
///  `stock_balances.avg_rate` and `value` are now DERIVED FROM THE LAYERS:
///  value = SUM(qty_remaining x rate), and avg_rate is that value over the
///  quantity. The ledger remains the truth for quantity; the layers are the
///  truth for cost.
///
///  OPENING LAYERS. The FIFO migration opened one layer per (item, location)
///  holding stock on the day, at the weighted average the system used before.
///  Nothing before that date is re-costed - an append-only ledger is not
///  rewritten - and `isOpening` marks those layers so the cut-over is visible.
/// ---------------------------------------------------------------------------
model StockCostLayer {
  id       String        @id @default(uuid()) @db.Uuid
  itemId   String        @map("item_id") @db.Uuid
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location String        @db.VarChar(80)
  rollId   String?       @map("roll_id") @db.Uuid

  /// The FIFO key: when this cost first entered the company. Carried through
  /// transfers unchanged.
  layerDate DateTime @map("layer_date") @db.Date

  /// The IN movement that opened this layer. Null only on opening layers.
  sourceLedgerId   String?      @map("source_ledger_id") @db.Uuid
  sourceLedger     StockLedger? @relation("LayerSource", fields: [sourceLedgerId], references: [id], onDelete: Restrict)
  sourceDocumentNo String       @map("source_document_no") @db.VarChar(60)

  qtyIn        Decimal @map("qty_in") @db.Decimal(18, 4)
  qtyRemaining Decimal @map("qty_remaining") @db.Decimal(18, 4)
  rate         Decimal @db.Decimal(18, 4)
  isOpening    Boolean @default(false) @map("is_opening")

  consumptions StockLayerConsumption[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([itemId, location, layerDate])
  @@index([sourceLedgerId])
  @@index([rollId])
  @@map("stock_cost_layers")
}

/// Which layers an OUT movement consumed, how much of each, at what cost.
/// Append-only, like the ledger it explains.
model StockLayerConsumption {
  id       String         @id @default(uuid()) @db.Uuid
  layerId  String         @map("layer_id") @db.Uuid
  layer    StockCostLayer @relation(fields: [layerId], references: [id], onDelete: Restrict)
  ledgerId String         @map("ledger_id") @db.Uuid
  ledger   StockLedger    @relation("LayerConsumption", fields: [ledgerId], references: [id], onDelete: Restrict)

  qty   Decimal @db.Decimal(18, 4)
  rate  Decimal @db.Decimal(18, 4)
  value Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([layerId])
  @@index([ledgerId])
  @@map("stock_layer_consumptions")
}

// ===========================================================================
//  MULTI-LINE DOCUMENTS  (session: gap-work / Odoo-Zoho comparison)
// ===========================================================================
//
//  One vendor document, many items. A tote needs webbing, zipper, puller,
//  D-rings, buckles, lining, thread, labels and cartons, usually from one
//  vendor on one PO and one bill.
//
//  The headers carry only what is true of the whole document - who, when,
//  which number, which bill. Everything per item (quantity, rate, tolerances,
//  the requirement ceiling, receipts) stays on the line rows, which are the
//  existing purchase_orders / vendor_quotations / grns tables. Totals are not
//  stored on a header: they are sums of its lines, computed when read, so a
//  header cannot disagree with its lines.

/// The purchase order a vendor receives. Lines: PurchaseOrder.
model PurchaseOrderHeader {
  id           String    @id @default(uuid()) @db.Uuid
  /// Vendor initials + running number - RF-012. Line 1 carries it bare.
  poNo         String    @unique @map("po_no") @db.VarChar(40)
  poDate       DateTime  @map("po_date") @db.Date
  vendorId     String    @map("vendor_id") @db.Uuid
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Snapshotted from the Vendor Master at creation, as on the lines.
  address      String?   @db.Text
  /// The buyer order the document is mostly for; each line keeps its own.
  orderId      String?   @map("order_id") @db.Uuid
  /// When the vendor is asked to deliver, and on what terms.
  deliveryDate DateTime? @map("delivery_date") @db.Date
  paymentTerms String?   @map("payment_terms") @db.VarChar(150)
  remarks      String?   @db.Text

  lines PurchaseOrder[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([vendorId])
  @@index([orderId])
  @@index([poDate])
  @@index([deletedAt])
  @@map("purchase_order_headers")
}

/// One vendor's quote, covering one or more items. Lines: VendorQuotation.
model VendorQuotationHeader {
  id            String    @id @default(uuid()) @db.Uuid
  quotationNo   String    @unique @map("quotation_no") @db.VarChar(40)
  quotationDate DateTime  @map("quotation_date") @db.Date
  vendorId      String    @map("vendor_id") @db.Uuid
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderId       String?   @map("order_id") @db.Uuid
  /// The vendor's own reference on their quote.
  vendorRefNo   String?   @map("vendor_ref_no") @db.VarChar(60)
  /// Prices are held until this date.
  validUntil    DateTime? @map("valid_until") @db.Date
  remarks       String?   @db.Text

  lines VendorQuotation[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([vendorId])
  @@index([orderId])
  @@index([quotationDate])
  @@index([deletedAt])
  @@map("vendor_quotation_headers")
}

/// One delivery against one vendor bill. Lines: Grn, one per PO line received.
model GrnHeader {
  id       String    @id @default(uuid()) @db.Uuid
  grnNo    String    @unique @map("grn_no") @db.VarChar(40)
  grnDate  DateTime  @map("grn_date") @db.Date
  vendorId String    @map("vendor_id") @db.Uuid
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// The vendor's invoice / delivery challan number, as on every line.
  billNo   String    @map("bill_no") @db.VarChar(60)
  billDate DateTime? @map("bill_date") @db.Date
  location String?   @db.VarChar(80)
  remarks  String?   @db.Text

  lines Grn[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([vendorId])
  @@index([billNo])
  @@index([grnDate])
  @@index([deletedAt])
  @@map("grn_headers")
}
