/// EXCEL SHEET: "Dye issue" - Dye Format   (Role Acess - Procurement Dept (Checker))
/// Process Doc s.5: "Fabric for dyeing is issued to the job worker under a
/// separate PO" - hence the DY-001 job work PO number carried here.
model DyeIssue {
  id String @id @default(uuid()) @db.Uuid

  /// C3 - the explicit workflow position. Job Work is now [A][S]: it carries
  /// an approval workflow AND it moves stock.
  ///
  /// Before C3 a job-work issue was a record with no authorisation step, and
  /// fabric reached a job worker on a bare Fabric Issue. It cannot any more:
  /// `assertIssuable()` refuses a Fabric Issue for a job-work purpose unless
  /// an APPROVED job work order names the same roll.
  ///
  /// Defaults to DRAFT, not to an approved state. A job work order that has
  /// not been decided has not been decided.
  workflowState DocumentState @default(DRAFT) @map("workflow_state")

  /// Job work PO number as printed in the workbook Remark column - DY-001.
  dyeIssueNo String @unique @map("dye_issue_no") @db.VarChar(40)

  /// Excel: "Date" (Auto)
  issueDate    DateTime       @map("issue_date") @db.Date
  /// Excel: "Process" (Manual -> L_Process): Dyeing / Printing / Washing / Finishing
  process      JobWorkProcess
  /// Excel: "Roll No" (Auto-Dropdown -> FabricRoll)
  rollId       String         @map("roll_id") @db.Uuid
  roll         FabricRoll     @relation(fields: [rollId], references: [id], onDelete: Restrict)
  /// Excel: "Colour Code" (Auto-Dropdown -> L_ColorCode)
  colourCode   String?        @map("colour_code") @db.VarChar(60)
  /// Excel: "Content" (Manual -> L_FabricContent)
  content      String?        @db.VarChar(80)
  /// Excel: "Count" (Manual -> L_Count)
  count        String?        @db.VarChar(20)
  /// Excel: "Construction" (Manual -> L_Construction)
  construction String?        @db.VarChar(20)
  /// Excel: "Width" (Manual) - inches
  width        Decimal?       @db.Decimal(10, 2)
  /// Excel: "GSM" (Manual -> L_GSM)
  gsm          String?        @db.VarChar(20)
  /// Excel: "Vendor Name" (Auto-Dropdown -> Vendor Master)
  vendorId     String         @map("vendor_id") @db.Uuid
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Excel: "Address" (Text, snapshot from Vendor Master)
  address      String?        @db.Text
  /// Excel: "Pin Code" (Number)
  pinCode      String?        @map("pin_code") @db.VarChar(12)
  /// Excel: "Qty" (Manual)
  qty          Decimal        @db.Decimal(18, 4)
  /// Excel: "UOM" (Auto -> L_UOM)
  uom          String         @db.VarChar(20)
  /// Excel: "Rate" (Manual) - job work rate
  rate         Decimal        @db.Decimal(18, 4)
  /// Excel: "Amount" (Auto = Qty x Rate)
  amount       Decimal        @db.Decimal(18, 2)
  /// Excel: "Remark" (Text)
  remark       String?        @db.Text

  /// Excel: "Fabric Stage" - whether the fabric goes out before or after
  /// stitching. The Printing sheet carries this column; the same distinction
  /// applies to every process routed through this register.
  fabricStage FabricStage @default(BEFORE_STITCHING) @map("fabric_stage")

  /// Style being served. The sheet reaches it through the order; naming it
  /// here lets a job-work register be read per style without a second join.
  styleId String? @map("style_id") @db.Uuid
  style   Style?  @relation(fields: [styleId], references: [id], onDelete: SetNull)

  /// Running totals maintained by DyeingReceipt as the lot comes back.
  /// Derived, never typed: recomputed from the receipts on every return.
  receivedQty  Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)
  /// Shrinkage across everything returned so far, as a fraction.
  /// (issuedQty - receivedQty) / issuedQty, and only meaningful once the lot is closed.
  shrinkagePct Decimal @default(0) @map("shrinkage_pct") @db.Decimal(9, 6)

  /// What has actually gone to the job worker on this order so far - the sum
  /// of its challans (fabric issues). A PO for 10,000 may go out as two
  /// challans of 5,000. Re-derived from the challans on every issue, never
  /// typed. `dye_issues_issued_within_ordered` keeps it within `qty`.
  issuedQty Decimal       @default(0) @map("issued_qty") @db.Decimal(18, 4)
  /// The challans that sent fabric out against this order.
  challans  FabricIssue[] @relation("JobWorkChallans")

  /// C3 - THE SHRINKAGE TOLERANCE THIS JOB WAS ISSUED UNDER, resolved from
  /// `shrinkage_rules` at creation and frozen here.
  ///
  /// THIS IS A RENAME of `standard_shrinkage_allowed`, whose DEFAULT of 0.03
  /// is exactly what C3 forbids: a job that never stated its tolerance
  /// silently inherited three per cent, and a later edit to the master would
  /// have moved the bar under a lot that was already at the vendor. There is
  /// no default now. Every job work order resolves and states its own.
  shrinkageTolerancePct Decimal @map("shrinkage_tolerance_pct") @db.Decimal(9, 6)

  /// Which `shrinkage_rules` version it came from, and what that version said
  /// on the day. The id alone is not enough: a version can be corrected.
  shrinkageRuleId    String? @map("shrinkage_rule_id") @db.Uuid
  shrinkageRuleBasis String? @map("shrinkage_rule_basis") @db.Text

  /// C3 - what the job worker is expected to send back:
  ///     issuedQty x (1 - shrinkageTolerancePct)
  /// Computed on the server, stored, and never typed. This is the figure a
  /// return is judged against, and storing it is what makes a historical job
  /// reproducible after the tolerance master moves on.
  expectedReturnQty Decimal @map("expected_return_qty") @db.Decimal(18, 4)

  /// C3 - the moment the OUT of the store and the IN at the job worker were
  /// committed together with this document.
  ///
  /// Non-null is the proof the fabric is on the job worker's floor in the
  /// ledger and not merely on a slip. It also gates the return: a lot issued
  /// before C3 carries no job-worker stock leg, and its return must not try
  /// to take stock out of a location that never received any.
  stockPostedAt     DateTime? @map("stock_posted_at") @db.Timestamptz(3)
  stockPostedById   String?   @map("stock_posted_by_id") @db.Uuid
  stockPostedByName String?   @map("stock_posted_by_name") @db.VarChar(120)

  /// The stock-keeping item behind the roll, resolved in the posting
  /// transaction so the return can find the same item without re-deriving it.
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// C3 - the location the fabric sits at while the job runs. Held on the row
  /// rather than recomputed from `process` so that a job issued under one
  /// naming convention keeps returning to the location it actually left for.
  jobWorkerLocation String @default("WITH JOB WORKER") @map("job_worker_location") @db.VarChar(80)

  /// Fabric Issue that released this roll to the job worker - the FIRST
  /// challan, kept for the older screens. `challans` holds all of them.
  fabricIssueId String?      @map("fabric_issue_id") @db.Uuid
  fabricIssue   FabricIssue? @relation("JobWorkFirstIssue", fields: [fabricIssueId], references: [id], onDelete: SetNull)
  /// Buyer order being served.
  orderId       String?      @map("order_id") @db.Uuid
  order         BuyerOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Excel-side status of the job work lot.
  status StatusGeneral @default(PENDING)

  receipts   DyeingReceipt[]
  gatePasses GatePass[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([vendorId])
  @@index([rollId])
  @@index([orderId])
  @@index([styleId])
  @@index([process])
  @@index([issueDate])
  @@index([status])
  @@index([workflowState])
  @@index([inventoryItemId])
  @@index([deletedAt])
  @@map("dye_issues")
}

/// EXCEL SHEET: "Dyeing Receipt" - Fabric Received from Dyeing (Shekwati4.xlsx)
/// (Role Acess - Procurement Dept (Checker))
/// Shrinkage % = (Qty Issued - Qty Received) / Qty Issued
/// Variation Flag = Yes when Shrinkage % > Standard Shrinkage Allowed
/// Status = OK / Sent to Scrutiny
model DyeingReceipt {
  id String @id @default(uuid()) @db.Uuid

  /// System receipt number (the sheet is keyed by Dye Issue PO No + Fabric No).
  receiptNo String @unique @map("receipt_no") @db.VarChar(40)

  /// Excel: "Date" (Auto)
  receiptDate              DateTime   @map("receipt_date") @db.Date
  /// Excel: "Dye Issue PO No" (Dropdown -> Dye issue)
  dyeIssueId               String     @map("dye_issue_id") @db.Uuid
  dyeIssue                 DyeIssue   @relation(fields: [dyeIssueId], references: [id], onDelete: Restrict)
  /// Excel: "Fabric No" (Auto -> FabricRoll)
  rollId                   String     @map("roll_id") @db.Uuid
  roll                     FabricRoll @relation(fields: [rollId], references: [id], onDelete: Restrict)
  /// Excel: "Qty Issued" (Auto, from the dye issue)
  qtyIssued                Decimal    @map("qty_issued") @db.Decimal(18, 4)
  /// Excel: "Qty Received" (Manual)
  qtyReceived              Decimal    @map("qty_received") @db.Decimal(18, 4)
  /// Excel: "Shrinkage %" (Formula)
  shrinkagePct             Decimal    @default(0) @map("shrinkage_pct") @db.Decimal(9, 6)
  /// Excel: "Standard Shrinkage Allowed" (Manual) - note on sheet "2-3%".
  /// C3: copied from the job work order, which froze it at issue. NOT
  /// re-resolved here - the bar a lot is judged by is the bar it left under.
  standardShrinkageAllowed Decimal    @map("standard_shrinkage_allowed") @db.Decimal(9, 6)
  /// Excel: "Variation Flag" (Formula = IF(Shrinkage % > Standard, "Yes", "No"))
  variationFlag            Boolean    @default(false) @map("variation_flag")

  // --- C4: THE CONDITIONAL SCRUTINY DECISION, TAKEN ONCE AND RECORDED ------
  //
  //  Whether a return needs scrutiny is decided HERE, on the return, from the
  //  variation against the process/vendor standard - not inferred later by
  //  whoever happens to be looking. `requiresScrutiny` is what the cutting
  //  floor's FABRIC_PROCESS_COMPLETE check reads, and NO SCRUTINY REQUIRED is
  //  a complete state, not an absent one.

  /// The variation this return produced against the standard, as a fraction.
  /// Positive is a shortfall. Stored rather than recomputed because the
  /// standard it was measured against can be superseded.
  variationPct     Decimal          @default(0) @map("variation_pct") @db.Decimal(9, 6)
  /// True when `variationPct` exceeded the standard and a Fabric Checking
  /// Report is therefore mandatory before the fabric may be cut.
  requiresScrutiny Boolean          @default(false) @map("requires_scrutiny")
  /// The scrutiny that satisfied the requirement, once one exists. Null while
  /// scrutiny is outstanding - which is exactly what blocks cutting.
  scrutinyId       String?          @map("scrutiny_id") @db.Uuid
  scrutiny         FabricScrutiny?  @relation(fields: [scrutinyId], references: [id], onDelete: SetNull)
  /// Excel: "Status" (Dropdown -> OK / Sent to Scrutiny)
  status           StatusDyeReceipt @default(OK)
  /// Excel: "Remarks" (Text)
  remarks          String?          @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([dyeIssueId])
  @@index([rollId])
  @@index([status])
  @@index([receiptDate])
  @@index([requiresScrutiny])
  @@index([scrutinyId])
  @@index([deletedAt])
  @@map("dyeing_receipts")
}

