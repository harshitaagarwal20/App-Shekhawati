// ===========================================================================
//  SHEKHAWATI IMPEX ERP - DATABASE SCHEMA
//  Phase 0 - Foundation
//
//  Scope of the application (fixed):
//    Masters -> Buyer Order -> Planning -> Vendor Quotation -> Quotation
//    Approval -> Purchase Order -> PO Approval -> Gate Pass -> GRN ->
//    Inventory -> Fabric Issue -> Dyeing -> Printing -> Fabric Scrutiny ->
//    Plan Approval -> Cutting Issue.
//
//  The application ENDS at Cutting Issue. No table in this schema models
//  Stitching Record, Hourly Monitoring, QC Size, QC Defects, Internal Quality
//  Check, Internal/Final Checker Report, Finished Checker, External Secondary
//  Checking, Alter Report, Spot Rectification-Scrap, Rejected, Packing,
//  Needle Checking, Dispatch or Reconciliation Report.
//
//  Source of truth for fields, dropdowns and formulas:
//    - "Shekwati Impex formats.xlsx"  (primary - latest format set)
//    - "Shekwati4.xlsx"               (supplementary - Dyeing Receipt sheet)
//    - "Current Process.xlsx"         (original captured process)
//    - "Sekhawati Impex Process Documentation.docx" (narrative business rules)
//
//  Every business column carries an /// EXCEL: comment naming the sheet and
//  the exact column caption it maps to, so that an ERP screen can always be
//  reconciled against the workbook it replaces.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
//  ENUMS
//  Only workflow-critical, closed lists become enums. Every open/extensible
//  dropdown from the "Master Lists" sheet lives in MasterList/MasterListValue
//  so users can keep adding values exactly as they do in the workbook.
// ===========================================================================

/// Master Lists!StatusGeneral - Pending / In Progress / Completed / On Hold / Cancelled
enum StatusGeneral {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

/// Master Lists!StatusApproval - Pending / Approved / Rejected
enum StatusApproval {
  PENDING
  APPROVED
  REJECTED
}

/// Excess approval on a Buyer Order. The Order sheet marks the "Excess" column
/// "Approval from dinesh sir", so any excess above zero is a Director decision.
/// NOT_REQUIRED is the state of an order that asks for no excess at all.
enum ExcessApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// Master Lists!StatusActive - Active / Inactive
enum StatusActive {
  ACTIVE
  INACTIVE
}

/// Master Lists!GatePassType - Inward / Outward
enum GatePassType {
  INWARD
  OUTWARD
}

/// Master Lists!StatusGatePass - Pending / Cleared
enum StatusGatePass {
  PENDING
  CLEARED
}

/// Master Lists!Decision - Accept / Reject / Rework  (Fabric Scrutiny Report)
enum ScrutinyDecision {
  ACCEPT
  REJECT
  REWORK
}

/// Master Lists!StatusDyeRecv - OK / Sent to Scrutiny  (Dyeing Receipt)
enum StatusDyeReceipt {
  OK
  SENT_TO_SCRUTINY
}

/// Master Lists!FabricStage - Before Stitching / After Stitching  (Printing)
enum FabricStage {
  BEFORE_STITCHING
  AFTER_STITCHING
}

/// Master Lists!Process - Dyeing / Printing / Washing / Finishing  (Dye issue)
enum JobWorkProcess {
  DYEING
  PRINTING
  WASHING
  FINISHING
}

/// Master Lists!Purpose - Cutting / Dyeing / Printing / Stitching / Return / Sampling / Other
enum IssuePurpose {
  CUTTING
  DYEING
  PRINTING
  STITCHING
  RETURN
  SAMPLING
  OTHER
}

/// Master Lists!GRNPurpose - Raw Material / Dyeing / Printing / Job Work Return / Accessories
enum GrnPurpose {
  RAW_MATERIAL
  DYEING
  PRINTING
  JOB_WORK_RETURN
  ACCESSORIES
}

/// Master Lists!PlanDept - Cutting / Stitching / Shipping / Packing
/// (Planning_ "Planning Department")
///
/// C14 - PACKING is a PLANNING DEPARTMENT, NOT A PACKING MODULE.
///
/// The office plans packing the same way it plans cutting, stitching and
/// shipping: a sheet of paper saying how many pieces are to be packed and by
/// when, signed before the work starts. That is a planning record.
///
/// There is still no packing execution in this system - no packing list, no
/// carton, no packed quantity, and no route or service that produces one. The
/// distinction is exactly the one `prisma/verify-scope.js` already draws for
/// STITCHING and SHIPPING, and the guard's `Packing` pattern matches a MODEL
/// (`model Packing`, `@@map("packings")`), not an enum value - so naming the
/// department here does not weaken it.
enum PlanDepartment {
  CUTTING
  STITCHING
  SHIPPING
  PACKING
  /// Pressing after stitching. A plan only, like PACKING above.
  IRON
}

/// C7 - which of the three plans a Plan Approval line carries.
///
/// SEPARATE FROM PlanDepartment, which is the Planning sheet's own column and
/// says who owns a material plan. This says what KIND of plan a version of a
/// Plan Approval header is presenting for signature.
///
/// SCOPE NOTE FOR verify-scope.js: STITCHING and SHIPPING here are PLAN TYPES -
/// a piece of paper the production office signs before work starts. They are
/// not stitching execution and not dispatch, neither of which exists in this
/// system. See the allowlist in prisma/verify-scope.js.
enum PlanType {
  CUTTING
  STITCHING
  SHIPPING
}

/// C2 - the three categories every purchased item belongs to, exactly one each.
///
/// DELIBERATELY NARROWER THAN L_ItemCategory, which carries eight open values
/// (Fabric, Accessories, Handle, Zipper, Label, Thread, Button, Packaging
/// Material) because that is what the workbook's dropdown offers and users
/// keep adding to it. Tolerance is not set per dropdown value - it is set per
/// COMMERCIAL CATEGORY, and there are three of those. `categoryOf()` in
/// src/domain/itemCategory.js is the single mapping between the two.
enum ItemCategory {
  FABRIC
  ACCESSORIES
  PACKAGING
}

/// C4 - the two defect families the Fabric Checking Report must capture, plus
/// the escape hatch for anything the checker finds that is neither.
///
/// The sheet's own note names "Dyeing Defect / Weaving Defect"; OTHER exists
/// so a checker is never forced to mis-file a finding in order to record it.
enum DefectCategory {
  DYEING
  WEAVING
  OTHER
}

/// Process Documentation s.5 - the two modes the PO module must support.
/// AS_PER_STYLE: qty is capped by Style.avgFabricUtilizationPerPc x order qty.
/// BULK: qty may exceed the average-based requirement.
///
/// C1: the mode a purchase order operates in. There is deliberately NO default
/// here and none on the column: which mode a PO runs in decides whether its
/// quantity is bounded at all, and that is too consequential to be inherited
/// by omission. Every PO states it.
enum PoOrderMode {
  /// Bounded by the style requirement: qty <= requirement x (1 + tolerance).
  AS_PER_STYLE
  /// Ordered directly against quantity. A linked style is reference only.
  BULK
}

/// Direction of a stock ledger movement.
enum StockDirection {
  IN
  OUT
}

/// Lifecycle position of a fabric roll inside the in-scope pipeline.
enum RollStage {
  RAW
  ISSUED_FOR_DYEING
  ISSUED_FOR_PRINTING
  DYED
  PRINTED
  SCRUTINY_HOLD
  ISSUED_TO_CUTTING
  CONSUMED
  REJECTED
}

/// The explicit workflow position of an approvable document.
///
/// Every approvable document in this system moves through the SAME states, so
/// that "where is this?" has one answer everywhere and a screen can render a
/// progress trail without knowing which module it is looking at.
///
///   DRAFT ──► SUBMITTED ──► PENDING_APPROVAL ──► APPROVED
///                                   │
///                                   ▼
///                               REJECTED ──► RECTIFICATION ──► RESUBMITTED
///                                                                   │
///                                                                   ▼
///                                                          PENDING_APPROVAL
///
/// SUBMITTED and PENDING_APPROVAL are deliberately distinct: a document can be
/// handed in before the person who has to decide it has it in front of them,
/// and the difference between "sent" and "on the approver desk" is the
/// difference between chasing the sender and chasing the approver.
///
/// RECTIFICATION is the state a rejected document sits in WHILE it is being
/// corrected; RESUBMITTED is the moment it goes back. Both are recorded rather
/// than collapsed into "pending again", because a plan on its third attempt
/// and a plan on its first are not the same risk.
enum DocumentState {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  /// Written to the ledger and acted on. A GRN that reached stock, a fabric
  /// issue that left the rack, a cutting challan the unit is holding. Distinct
  /// from APPROVED because authorising a thing and doing it are different acts,
  /// and only some documents do both.
  POSTED
  /// Finished. A PO fully received, a job work lot fully returned. Terminal.
  COMPLETED
  REJECTED
  RECTIFICATION
  RESUBMITTED
  CANCELLED
}

/// What an excess rule applies to. Narrower scopes win over wider ones.
enum ExcessScope {
  /// The fallback that applies when nothing more specific matches.
  GLOBAL
  /// Per document type - purchase orders may allow more than cutting issues.
  DOCUMENT_TYPE
  /// Per item category - accessories are held tighter than fabric.
  ITEM_CATEGORY
  /// Per buyer - some buyers contract for a different tolerance.
  BUYER
  /// Per order - the narrowest scope, and the one that always wins.
  ORDER
}

/// Action recorded on the approval trail of any approvable document.
/// Whether a purchase is taxed as CGST+SGST or as IGST.
///
/// Derived from the vendor's GSTIN state code against the company's own, and
/// then STORED on the receipt - so an invoice reprinted next year shows what
/// was charged, not what today's vendor master would imply.
enum SupplyType {
  INTRA_STATE
  INTER_STATE
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  /// Written to the ledger and acted on. Distinct from APPROVED because
  /// authorising a thing and doing it are different acts - a GRN is posted
  /// without anybody approving it, and a cutting challan is approved by the
  /// supervisor and then posted. A trail that called both "Submitted" told the
  /// reader the wrong thing.
  POSTED
  /// Ran its course. A PO fully received, a job work lot fully returned.
  COMPLETED
  REJECTED
  REWORK_REQUESTED
  CANCELLED
  REOPENED
  /// The document was changed after it was locked, through its amendment
  /// mechanism. The before-and-after set lives in DocumentAmendment; this is
  /// the entry that puts the amendment on the approval trail beside the
  /// decisions, so a reader sees the whole sequence in one place.
  AMENDED
}

/// Every numbered / auditable document type in scope. Drives DocumentSequence,
/// ApprovalHistory, DocumentAmendment and StockLedger back-references.
enum DocumentType {
  BUYER
  VENDOR
  EMPLOYEE
  STYLE
  BUYER_ORDER
  PLANNING
  VENDOR_QUOTATION
  PURCHASE_ORDER
  GATE_PASS
  GRN
  FABRIC_ROLL
  /// Not a document in the workbook sense - the inventory master has no
  /// sheet at all. It is here because item codes (ITM-0001) are issued from
  /// the same counter table as every other number, inside the GRN
  /// transaction, so a rolled-back receipt never burns an item code.
  INVENTORY_ITEM
  FABRIC_ISSUE
  DYE_ISSUE
  DYEING_RECEIPT
  PRINTING
  FABRIC_SCRUTINY
  PLAN_APPROVAL
  /// C12 - the raw material plan. What fabric and accessories this order needs
  /// bought in from vendors, signed before procurement goes to the market.
  MATERIAL_PLAN
  /// C5 - the requirement the cutting department raises before any fabric is
  /// issued to it. Approval-enabled; a Fabric Issue must quote one of its lines.
  CUTTING_CHALLAN
  CUTTING_ISSUE
  /// Cut pieces received from the cutting department. Numbered CPR-0001.
  CUT_PIECES_RECEIPT
  /// F-04 - the compensating document for a receipt that should not have been
  /// posted. Numbered GRV-0001 and approved by somebody other than whoever
  /// raised it. See model GrnReversal.
  GRN_REVERSAL
  /// The FOB cost sheet of a style - CS-0001. See model StyleCostSheet.
  COST_SHEET
}

// ===========================================================================
//  1. AUTHENTICATION, USERS, ROLES, PERMISSIONS
// ===========================================================================

/// Application login. Optionally tied to an Employee Master record so that
/// "Checked By" / "Prepared By" style columns can resolve to a real person.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(60)
  email              String?   @unique @db.VarChar(150)
  fullName           String    @map("full_name") @db.VarChar(120)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  roles    UserRole[]
  sessions UserSession[]

  /// Where this person wants to be told about work waiting for them. In-app
  /// notifications always happen; these only add channels.
  notifyByEmail    Boolean @default(true) @map("notify_by_email")
  notifyByWhatsapp Boolean @default(false) @map("notify_by_whatsapp")
  /// International format, digits only after the plus - "919876543210".
  whatsappNumber   String? @map("whatsapp_number") @db.VarChar(20)

  notifications Notification[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([isActive])
  @@index([deletedAt])
  @@index([employeeId])
  @@map("users")
}

/// Role as printed on the "Role Acess - ..." banner of every workbook sheet.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(60)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([deletedAt])
  @@map("roles")
}

/// Fine-grained permission, expressed as module + action (e.g. PURCHASE_ORDER.APPROVE).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(80)
  module      String  @db.VarChar(60)
  action      String  @db.VarChar(30)
  description String? @db.VarChar(255)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// A live login session. Access tokens are short-lived JWTs; the refresh token
/// is stored here as a SHA-256 hash so that logout, "log out everywhere" and
/// forced revocation on role change are real server-side actions rather than a
/// client-side token discard.
model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The token itself is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why the session ended - LOGOUT / LOGOUT_ALL / ROTATED / REUSE_DETECTED / ADMIN.
  revokedReason    String?   @map("revoked_reason") @db.VarChar(40)

  ipAddress String? @map("ip_address") @db.VarChar(60)
  userAgent String? @map("user_agent") @db.VarChar(255)

  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

// ===========================================================================
//  2. SYSTEM - DOCUMENT NUMBERING, APPROVAL TRAIL, AMENDMENTS, AUDIT
// ===========================================================================

/// Generates the document numbers the workbook produces by hand.
///
/// scopeKey lets one document type run several independent counters, which the
/// workbook requires:
///   PURCHASE_ORDER  -> scopeKey = vendor initials  ("RF", "MA")  => RF-001
///   BUYER           -> scopeKey = buyer initials   ("TWA")       => TWA#
///   everything else -> scopeKey = "" (single global counter)     => GP-001
model DocumentSequence {
  id           String       @id @default(uuid()) @db.Uuid
  documentType DocumentType @map("document_type")
  scopeKey     String       @default("") @map("scope_key") @db.VarChar(40)
  prefix       String       @default("") @db.VarChar(20)
  suffix       String       @default("") @db.VarChar(20)
  separator    String       @default("-") @db.VarChar(5)
  padLength    Int          @default(3) @map("pad_length")
  nextNumber   Int          @default(1) @map("next_number")
  description  String?      @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([documentType, scopeKey])
  @@map("document_sequences")
}

/// Time-stamped approval trail. Replaces the manual sign-off columns
/// ("Authorised By", "Authorisation Status", "Approved Date") with real history.
/// Polymorphic on (documentType, documentId) so one trail serves every stage.
model ApprovalHistory {
  id           String       @id @default(uuid()) @db.Uuid
  documentType DocumentType @map("document_type")
  documentId   String       @map("document_id") @db.Uuid
  documentNo   String       @map("document_no") @db.VarChar(60)
  sequenceNo   Int          @default(1) @map("sequence_no")

  action     ApprovalAction
  fromStatus String?        @map("from_status") @db.VarChar(30)
  toStatus   String?        @map("to_status") @db.VarChar(30)

  /// Free-text name as printed in the workbook ("Dinesh Sir", "Vinay ji (GM)").
  actedByName String?  @map("acted_by_name") @db.VarChar(120)
  actedById   String?  @map("acted_by_id") @db.Uuid
  actedAt     DateTime @default(now()) @map("acted_at") @db.Timestamptz(3)
  remarks     String?  @db.Text

  @@index([documentType, documentId])
  @@index([actedAt])
  @@map("approval_history")
}

/// Records an amendment to an already-issued document (revised PO qty/rate,
/// revised plan, corrected GRN receipt). Stores a field-level before/after set.
model DocumentAmendment {
  id           String       @id @default(uuid()) @db.Uuid
  documentType DocumentType @map("document_type")
  documentId   String       @map("document_id") @db.Uuid
  documentNo   String       @map("document_no") @db.VarChar(60)
  amendmentNo  Int          @map("amendment_no")

  reason  String  @db.Text
  changes Json    @db.JsonB
  remarks String? @db.Text

  amendedById String?  @map("amended_by_id") @db.Uuid
  amendedAt   DateTime @default(now()) @map("amended_at") @db.Timestamptz(3)

  @@unique([documentType, documentId, amendmentNo])
  @@index([documentType, documentId])
  @@map("document_amendments")
}

/// A CONFIGURABLE excess / wastage threshold.
///
/// The number 2% appears all over the workbook - "2-3%" on the PO sheet, a 2%
/// receipt variation in the process document, 2-3% shrinkage on a dye lot. It
/// is a DEFAULT, not a law: a buyer can contract for 5%, a particular order
/// can be agreed at 1%, and an accessory is held to 1% because it is cheap to
/// re-order and expensive to store.
///
/// So no percentage is compiled into this application. Every excess check
/// resolves a rule out of this table, narrowest scope first:
///
///     ORDER  ►  BUYER  ►  ITEM_CATEGORY  ►  DOCUMENT_TYPE  ►  GLOBAL
///
/// The seeded rows reproduce the workbook thresholds exactly, so the system
/// behaves out of the box as the office expects - and the office can change
/// any of them on a screen, without a deployment.
model ExcessRule {
  id String @id @default(uuid()) @db.Uuid

  /// What this rule applies to.
  scope    ExcessScope
  /// The value the scope is keyed on: an order id, a buyer id, "Accessories",
  /// a DocumentType name. Empty for GLOBAL, which matches everything.
  scopeKey String      @default("") @map("scope_key") @db.VarChar(80)

  /// Narrow the rule to one kind of document. Null means every document.
  documentType DocumentType? @map("document_type")

  /// The permitted excess, as a fraction. 0.02 = 2%.
  excessPct Decimal @map("excess_pct") @db.Decimal(9, 6)

  /// A HARD ceiling: excess beyond this cannot be approved at all, only
  /// refused. Null means an approver may authorise any excess with a reason.
  hardCeilingPct Decimal? @map("hard_ceiling_pct") @db.Decimal(9, 6)

  /// Whether exceeding excessPct needs an authorisation before the transaction
  /// can be posted. Almost always true; false makes the threshold advisory.
  requiresApproval Boolean @default(true) @map("requires_approval")

  /// Human-readable justification, shown next to the number on the screen so
  /// nobody has to guess where 2% came from.
  basis String? @db.VarChar(255)

  /// Priority within a scope, highest first. Breaks ties between two rules
  /// that match equally well.
  priority Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([scope, scopeKey, documentType])
  @@index([scope, isActive])
  @@index([documentType])
  @@index([deletedAt])
  @@map("excess_rules")
}

// ===========================================================================
//  2b. THE TOLERANCE MASTER  (C2, C3)
// ===========================================================================

/// C2 - THE DATE-VERSIONED TOLERANCE MASTER, per item category.
///
/// ---------------------------------------------------------------------------
///  WHY THIS IS NOT ExcessRule
///
///  `excess_rules` above resolves ONE percentage for ONE document type and
///  drives the excess-AUTHORISATION workflow (assess -> request -> approve ->
///  consume). It cannot express what C2 asks for, for two structural reasons:
///
///    1. `@@unique([scope, scopeKey, documentType])` permits exactly one live
///       row per (scope, key, type). A rule that is versioned by date needs
///       MANY rows for the same key - one per effective period - so the
///       effective_from / effective_to columns on that model can never
///       actually be used to version anything. They only close a rule down.
///
///    2. A category carries TWO tolerances that are read together - what may
///       be ordered and what may be received - and a document that quotes one
///       has to freeze both, because a PO raised today is received against
///       weeks later. Two `excess_rules` rows cannot be resolved atomically as
///       one dated version.
///
///  So this table owns the category tolerances and is versioned by
///  `effective_from`; `excess_rules` keeps the authorisation workflow it was
///  built for. Neither is a copy of the other. `tolerance.service.js` is the
///  only reader.
///
///  NOTHING IS INVENTED HERE. A category with no row resolves to no tolerance
///  and says so - see `resolveCategoryTolerance()`, which reports the gap
///  rather than falling back to a number nobody approved.
/// ---------------------------------------------------------------------------
model ToleranceRule {
  id String @id @default(uuid()) @db.Uuid

  /// The commercial category this version governs.
  category ItemCategory

  /// What may be ORDERED over the computed requirement, as a fraction.
  /// 0.01 = 1%.
  orderTolerancePct   Decimal @map("order_tolerance_pct") @db.Decimal(9, 6)
  /// What may be RECEIVED over the ordered quantity, as a fraction, measured
  /// CUMULATIVELY across every GRN raised against the same purchase order.
  receiptTolerancePct Decimal @map("receipt_tolerance_pct") @db.Decimal(9, 6)

  /// The day this version starts applying. THE VERSION KEY: a document
  /// resolves the row with the latest `effectiveFrom` on or before its own
  /// date, which is what makes a historical document reproducible after the
  /// master moves on.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Closed when a successor version starts. Null means "still current".
  /// Maintained by the service, never typed: superseding a version and
  /// opening its successor is one transaction.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Where the number came from, in words. Printed beside it on screen so
  /// nobody has to guess who agreed to 1%.
  basis    String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  /// One version per category per start date. This is the constraint
  /// `excess_rules` could not offer.
  @@unique([category, effectiveFrom])
  @@index([category, isActive])
  @@index([effectiveFrom])
  @@index([deletedAt])
  @@map("tolerance_rules")
}

/// C3 - shrinkage tolerance for a job-work process, date-versioned.
///
/// Keyed on PROCESS and optionally VENDOR, which is the axis the brief names
/// and the one neither `excess_rules` (document type / category / buyer /
/// order) nor `tolerance_rules` (item category) can express. A row with a null
/// `vendorId` is the process-wide standard; a row naming a vendor beats it,
/// because a dye house that consistently returns tighter is worth holding to
/// its own number.
model ShrinkageRule {
  id String @id @default(uuid()) @db.Uuid

  process  JobWorkProcess
  /// Null = every job worker running this process.
  vendorId String?        @map("vendor_id") @db.Uuid
  vendor   Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Permitted shortfall on return, as a fraction. 0.03 = 3%.
  /// A return passes when returnedQty >= issuedQty x (1 - this).
  shrinkageTolerancePct Decimal @map("shrinkage_tolerance_pct") @db.Decimal(9, 6)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  basis    String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([process, vendorId, effectiveFrom])
  @@index([process, isActive])
  @@index([vendorId])
  @@index([deletedAt])
  @@map("shrinkage_rules")
}

/// One transaction that went over its permitted excess, and what was done
/// about it.
///
/// Every field the brief asks for is a column here rather than a calculation
/// somebody has to redo: base quantity, permitted excess percentage, permitted
/// excess quantity, actual excess, excess percentage, approval status,
/// approver, approval date and reason.
///
/// The row is written when the excess is DETECTED, not when it is approved, so
/// an over-limit transaction that was refused still leaves a trace of having
/// been attempted.
model ExcessApproval {
  id String @id @default(uuid()) @db.Uuid

  /// The transaction this excess belongs to. Polymorphic, like the approval
  /// trail, because every module can breach a threshold in its own way.
  documentType DocumentType @map("document_type")
  /// Null until the document exists: the check runs BEFORE the transaction is
  /// written, so an authorisation can be obtained and then used.
  documentId   String?      @map("document_id") @db.Uuid
  documentNo   String?      @map("document_no") @db.VarChar(60)

  /// What the excess was measured against, and where the threshold came from.
  orderId   String?     @map("order_id") @db.Uuid
  order     BuyerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ruleId    String?     @map("rule_id") @db.Uuid
  /// The rule text as it read when the check ran. A rule can be edited later;
  /// what was authorised must keep saying what it was authorised against.
  ruleBasis String?     @map("rule_basis") @db.VarChar(255)

  /// THE NUMBERS. All nine of them, stored rather than recomputed.
  baseQty         Decimal @map("base_qty") @db.Decimal(18, 4)
  permittedPct    Decimal @map("permitted_pct") @db.Decimal(9, 6)
  permittedQty    Decimal @map("permitted_qty") @db.Decimal(18, 4)
  maxPermittedQty Decimal @map("max_permitted_qty") @db.Decimal(18, 4)
  actualQty       Decimal @map("actual_qty") @db.Decimal(18, 4)
  actualExcessQty Decimal @map("actual_excess_qty") @db.Decimal(18, 4)
  actualExcessPct Decimal @map("actual_excess_pct") @db.Decimal(9, 6)
  /// How far past the PERMITTED excess the transaction went - the quantity an
  /// approver is actually being asked to authorise.
  overLimitQty    Decimal @map("over_limit_qty") @db.Decimal(18, 4)
  uom             String  @default("") @db.VarChar(20)

  /// Pending until somebody with the authority decides.
  status StatusApproval @default(PENDING)

  /// Why the excess is being asked for. Required to raise the request.
  reason String @db.Text

  requestedById   String?  @map("requested_by_id") @db.Uuid
  requestedByName String?  @map("requested_by_name") @db.VarChar(120)
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)

  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedByName  String?   @map("approved_by_name") @db.VarChar(120)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionRemarks String?   @map("decision_remarks") @db.Text
  rejectionReason String?   @map("rejection_reason") @db.Text

  /// Consumed once the transaction it authorises has been posted, so one
  /// authorisation cannot be spent twice.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  cuttingIssues CuttingIssue[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([documentType, documentId])
  @@index([orderId])
  @@index([status])
  @@index([requestedAt])
  @@map("excess_approvals")
}

/// Row-level change log for every in-scope table (who changed what, when).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tableName String   @map("table_name") @db.VarChar(80)
  recordId  String   @map("record_id") @db.Uuid
  action    String   @db.VarChar(20)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  userId    String?  @map("user_id") @db.Uuid
  userName  String?  @map("user_name") @db.VarChar(120)
  ipAddress String?  @map("ip_address") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ===========================================================================
//  3. MASTERS
// ===========================================================================

/// One column of the "Master Lists" sheet (Country, UOM, ColorCode, GSM ...).
/// The workbook rule is: "add a new value at the bottom of a column and every
/// dropdown picks it up automatically" - so these lists must stay editable and
/// therefore cannot be Prisma enums.
model MasterList {
  id          String  @id @default(uuid()) @db.Uuid
  /// Excel: Master Lists row-4 caption, e.g. "ColorCode".
  code        String  @unique @db.VarChar(60)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)
  /// System lists cannot be deleted, only extended.
  isSystem    Boolean @default(true) @map("is_system")

  values MasterListValue[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([deletedAt])
  @@map("master_lists")
}

/// A single dropdown value inside a MasterList, stored verbatim as it appears
/// in the workbook ("10 oz", "320 GSM", "Unit 1 - Anil Kumar").
model MasterListValue {
  id     String     @id @default(uuid()) @db.Uuid
  listId String     @map("list_id") @db.Uuid
  list   MasterList @relation(fields: [listId], references: [id], onDelete: Cascade)

  /// The exact text shown in the workbook / ERP dropdown.
  value      String  @db.VarChar(150)
  /// Optional short code for integrations; defaults to value.
  code       String? @db.VarChar(60)
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")
  /// Extra attributes some lists carry (e.g. ContainerNo -> capacity).
  attributes Json?   @db.JsonB

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([listId, value])
  @@index([listId, isActive, sortOrder])
  @@index([deletedAt])
  @@map("master_list_values")
}

/// EXCEL SHEET: "Buyer Master"   (Role Acess - Head Office / Admin)
model Buyer {
  id String @id @default(uuid()) @db.Uuid

  /// Excel: "Buyer Code" (Auto). Note on the sheet: "Come from buyer initial
  /// letters" - e.g. Trade Word -> TWA#, Global Bags Ltd -> GBL#.
  buyerCode          String       @unique @map("buyer_code") @db.VarChar(20)
  /// Excel: "Buyer Name" (Manual)
  buyerName          String       @map("buyer_name") @db.VarChar(150)
  /// Excel: "Address" (Manual)
  address            String?      @db.Text
  /// Excel: "Country" (Dropdown -> L_Country)
  country            String?      @db.VarChar(80)
  /// Excel: "Contact Person" (Manual)
  contactPerson      String?      @map("contact_person") @db.VarChar(120)
  /// Excel: "Email" (Manual)
  email              String?      @db.VarChar(150)
  /// Excel: "Phone" (Manual)
  phone              String?      @db.VarChar(40)
  /// Excel: "Currency" (Dropdown -> L_Currency)
  currency           String?      @db.VarChar(10)
  /// Excel: "Payment Terms" (Manual / L_PaymentTerms)
  paymentTerms       String?      @map("payment_terms") @db.VarChar(150)
  /// Excel: "Status" (Dropdown -> Active/Inactive)
  status             StatusActive @default(ACTIVE)
  /// Excel: "Consignee Name" (Manual)
  consigneeName      String?      @map("consignee_name") @db.VarChar(200)
  /// Excel: "Consignee Address" (Manual)
  consigneeAddress   String?      @map("consignee_address") @db.Text
  /// Excel: "Notify Party Name" (Manual)
  notifyPartyName    String?      @map("notify_party_name") @db.VarChar(200)
  /// Excel: "Notify Party Address" (Manual)
  notifyPartyAddress String?      @map("notify_party_address") @db.Text
  /// Excel: "Destination" (Dropdown)
  destination        String?      @db.VarChar(120)
  /// Excel: "Port of Discharge" (Manual)
  portOfDischarge    String?      @map("port_of_discharge") @db.VarChar(120)
  /// Excel: "Final Destination" (Dropdown)
  finalDestination   String?      @map("final_destination") @db.VarChar(120)
  /// Excel: "Price Terms (Incoterm)" (Manual), e.g. "FOB Jaipur, India"
  priceTerms         String?      @map("price_terms") @db.VarChar(150)
  /// Excel: "Ship Mode" (Dropdown -> L_ShipMode)
  shipMode           String?      @map("ship_mode") @db.VarChar(40)
  /// Excel: "Freight Terms" (Dropdown), e.g. Prepaid / Collect
  freightTerms       String?      @map("freight_terms") @db.VarChar(40)

  styles Style[]
  orders BuyerOrder[]

  /// Every other place this buyer's goods go. See BuyerAddress.
  addresses BuyerAddress[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([buyerName])
  @@index([status])
  @@index([deletedAt])
  @@map("buyers")
}

/// A destination this buyer ships to, beyond the three the Buyer row itself
/// carries.
///
/// ---------------------------------------------------------------------------
///  WHY THIS TABLE EXISTS
///
///  A buyer used to hold exactly three addresses, and they are three ROLES on a
///  shipping document rather than three slots: its own address, the consignee,
///  and the notify party. Those stay where they are, because the printed
///  documents, the import sheet and the export all name them individually.
///
///  But a buyer ships to more places than that. Trade Word's orders went twice
///  to "Trade Word DC, New Jersey", which is not any of its three - so it was
///  typed by hand each time, was offered by nothing, and was forgotten the
///  moment the order was saved. A retyped address is how a container ends up at
///  last season's warehouse.
///
///  This is the address book: as many as the buyer has, each with a label
///  somebody would actually say out loud ("Tokyo warehouse"), offered on the
///  order's Ship To beside the three named ones.
///
///  NOT A REPLACEMENT for consignee and notify party. Those answer "who is
///  named on the paperwork"; these answer "where has this buyer had us send
///  things". Folding them together would lose the distinction the documents
///  depend on.
/// ---------------------------------------------------------------------------
model BuyerAddress {
  id      String @id @default(uuid()) @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid
  buyer   Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  /// Position in the buyer's own list, so the picker offers them in the order
  /// the office arranged rather than in whatever order the rows came back.
  lineNo Int @map("line_no")

  /// What the office calls it - "Head office", "Tokyo warehouse", "DC". This
  /// is the label in the dropdown, so it has to mean something to a reader.
  label String @db.VarChar(80)

  /// Who is at the address. Goes onto Ship To ahead of the address itself,
  /// because an order that ships to a street with nobody named on it is how a
  /// delivery gets refused at the gate.
  name String? @db.VarChar(200)

  address String  @db.Text
  country String? @map("country") @db.VarChar(80)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([buyerId, lineNo])
  @@index([buyerId])
  @@index([deletedAt])
  @@map("buyer_addresses")
}

/// EXCEL SHEET: "Vendor Master"   (Role Acess - Head Office / Admin)
model Vendor {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderHeaders   PurchaseOrderHeader[]
  vendorQuotationHeaders VendorQuotationHeader[]
  grnHeaders             GrnHeader[]

  /// Excel: "Vendor Code" (Auto) - VEN-001
  vendorCode     String       @unique @map("vendor_code") @db.VarChar(20)
  /// Excel: "Vendor Name" (Manual)
  vendorName     String       @map("vendor_name") @db.VarChar(150)
  /// Excel: "Category" (Dropdown -> L_VendorCategory): Fabric / Accessories /
  /// Dyeing / Printing / Stitching Unit / External QC / Transport / Other
  category       String       @db.VarChar(60)
  /// Excel: "Address" (Manual)
  address        String?      @db.Text
  /// Excel: "City" (Manual)
  city           String?      @db.VarChar(120)
  /// Excel: "Vendor Location" (Manual) - where the work is physically done,
  /// which is not always where the vendor bills from. Kept beside the address
  /// rather than folded into it because the Vendor Master lists it as its own
  /// column and the store asks for vendors by location.
  vendorLocation String?      @map("vendor_location") @db.VarChar(120)
  /// Excel: "GST No" (Manual)
  gstNo          String?      @map("gst_no") @db.VarChar(20)
  /// Excel: "Contact Person" (Manual)
  contactPerson  String?      @map("contact_person") @db.VarChar(120)
  /// Excel: "Phone" (Manual)
  phone          String?      @db.VarChar(40)
  /// Excel: "Email" (Manual)
  email          String?      @db.VarChar(150)
  /// Excel: "Bank Details" (Manual)
  bankDetails    String?      @map("bank_details") @db.VarChar(200)
  /// Excel: "Status" (Dropdown -> Active/Inactive)
  status         StatusActive @default(ACTIVE)
  /// Excel: "Remarks" (Text)
  remarks        String?      @db.Text

  /// Initials used to build the PO ID (Rajasthan Fabrics -> "RF" -> RF-001).
  /// Derived from vendorName on create; editable because the workbook shows
  /// the buyer/vendor initials being chosen by a human.
  poInitials String? @map("po_initials") @db.VarChar(10)

  /// Pin code kept here because the "Dye issue" sheet prints it per vendor.
  pinCode String? @map("pin_code") @db.VarChar(12)

  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]
  gatePasses     GatePass[]
  grns           Grn[]
  fabricRolls    FabricRoll[]
  fabricIssues   FabricIssue[]
  dyeIssues      DyeIssue[]
  printings      Printing[]
  /// C3 - vendor-specific shrinkage tolerances, where this job worker has been
  /// held to a number of its own.
  shrinkageRules ShrinkageRule[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([vendorName])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("vendors")
}

/// EXCEL SHEET: "Employee Master"   (Role Acess - Admin)
model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Excel: "Emp ID" (Auto) - EMP-001
  empId       String       @unique @map("emp_id") @db.VarChar(20)
  /// Excel: "Emp Name" (Manual)
  empName     String       @map("emp_name") @db.VarChar(120)
  /// Excel: "Department" (Dropdown -> L_Department)
