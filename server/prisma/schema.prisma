  designation String       @db.VarChar(60)
  /// Excel: "Unit / Line" (Dropdown -> L_StitchingUnit or a free location)
  unitLine    String?      @map("unit_line") @db.VarChar(80)
  /// Excel: "Status" (Dropdown -> Active/Inactive)
  status      StatusActive @default(ACTIVE)

  users             User[]
  fabricIssues      FabricIssue[]
  scrutinyChecks    FabricScrutiny[]
  gatePasses        GatePass[]
  cutPiecesReceipts CutPiecesReceipt[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
